"locale\":\"ar\"}},{\"id\":10106,\"attributes\":{\"name\":\"phone_number_text\",\"value\":\"رقم الهاتف\",\"createdAt\":\"2025-02-05T11:29:33.657Z\",\"updatedAt\":\"2025-02-05T11:29:33.657Z\",\"locale\":\"ar\"}},{\"id\":10108,\"attributes\":{\"name\":\"receive_an_sms_with_your_reset link\",\"value\":\"تلقي رسالة قصيرة تحتوي على رابط إعادة تعيين كلمة السر الخاصة بك.\",\"createdAt\":\"2025-02-05T11:29:34.960Z\",\"updatedAt\":\"2025-02-05T11:29:34.960Z\",\"locale\":\"ar\"}},{\"id\":10110,\"attributes\":{\"name\":\"select_an_option_below\",\"value\":\"تحديد خيار آخر\",\"createdAt\":\"2025-02-05T11:29:36.105Z\",\"updatedAt\":\"2025-02-05T11:29:36.105Z\",\"locale\":\"ar\"}},{\"id\":10112,\"attributes\":{\"name\":\"add_more\",\"value\":\"إضافة المزيد\",\"createdAt\":\"2025-02-05T11:29:37.355Z\",\"updatedAt\":\"2025-02-05T11:29:37.355Z\",\"locale\":\"ar\"}},{\"id\":10114,\"attributes\":{\"name\":\"quick_actions\",\"value\":\"عمليات سريعة\",\"createdAt\":\"2025-02-05T11:29:38.512Z\",\"updatedAt\":\"2025-02-05T11:29:38.512Z\",\"locale\":\"ar\"}},{\"id\":10116,\"attributes\":{\"name\":\"Energy_500\",\"value\":\"الدورات المفعلة\",\"createdAt\":\"2025-02-05T11:29:39.721Z\",\"updatedAt\":\"2025-02-05T11:29:39.721Z\",\"locale\":\"ar\"}},{\"id\":10118,\"attributes\":{\"name\":\"email_sent_desc\",\"value\":\"سيتم إرسال بريد إلكتروني إلى عنوان البريد الإلكتروني الخاص بك. اضغط على الرابط للتحقق من حسابك.\",\"createdAt\":\"2025-02-05T11:29:40.979Z\",\"updatedAt\":\"2025-02-06T05:37:00.056Z\",\"locale\":\"ar\"}},{\"id\":10120,\"attributes\":{\"name\":\"argument name\",\"value\":\"البريد الإلكتروني\",\"createdAt\":\"2025-02-05T11:29:42.099Z\",\"updatedAt\":\"2025-02-05T11:29:42.099Z\",\"locale\":\"ar\"}},{\"id\":10122,\"attributes\":{\"name\":\"bundles_uppercase\",\"value\":\"الاشتراكات\",\"createdAt\":\"2025-02-05T11:29:43.323Z\",\"updatedAt\":\"2025-02-05T11:29:43.323Z\",\"locale\":\"ar\"}},{\"id\":10172,\"attributes\":{\"name\":\"Energy_Liberty_3500\",\"value\":\"الاشتراك 3500\",\"crea