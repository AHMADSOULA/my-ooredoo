:\"ar\"}},{\"id\":15109,\"attributes\":{\"name\":\"tod_welcome_text_phase2\",\"value\":\"واصلوا الاستمتاع بأجواء كأس العالم بسعر استثنائي على شاشة تلفازكم أو هاتفكم! شاهدوا جميع المباريات حتى النهائي، واحصلوا على 12 شهرًا من الأفلام والمسلسلات، وكل هذا على TOD.\",\"createdAt\":\"2026-06-04T15:39:22.004Z\",\"updatedAt\":\"2026-06-04T15:48:30.095Z\",\"locale\":\"ar\"}},{\"id\":15118,\"attributes\":{\"name\":\"world_cup_portal_enable\",\"value\":\"true\",\"createdAt\":\"2026-06-07T13:12:11.954Z\",\"updatedAt\":\"2026-06-07T13:12:11.954Z\",\"locale\":\"ar\"}},{\"id\":15121,\"attributes\":{\"name\":\"level_up_service_image\",\"value\":\"/uploads/bundle_icon_31c1e4774b.png\",\"createdAt\":\"2026-06-08T10:06:00.989Z\",\"updatedAt\":\"2026-06-08T10:06:00.989Z\",\"locale\":\"ar\"}},{\"id\":15124,\"attributes\":{\"name\":\"qualtrics_survey_display_time_second\",\"value\":\"80\",\"createdAt\":\"2026-06-08T10:29:24.428Z\",\"updatedAt\":\"2026-06-08T10:58:31.043Z\",\"locale\":\"ar\"}},{\"id\":15127,\"attributes\":{\"name\":\"level_up_success_purchase_title\",\"value\":\"تم تفعيل الباقة!\",\"createdAt\":\"2026-06-08T13:38:27.721Z\",\"updatedAt\":\"2026-06-08T13:58:53.672Z\",\"locale\":\"ar\"}},{\"id\":15130,\"attributes\":{\"name\":\"level_up_success_purchase_description\",\"value\":\"استمتع بمزايا اشتراكك الجديد!\",\"createdAt\":\"2026-06-08T13:39:09.516Z\",\"updatedAt\":\"2026-06-08T14:05:25.285Z\",\"locale\":\"ar\"}},{\"id\":15133,\"attributes\":{\"name\":\"myo_tod_auto_popup_restricted_time_in_hours\",\"value\":\"24\",\"createdAt\":\"2026-06-08T14:08:23.106Z\",\"updatedAt\":\"2026-06-08T14:32:02.696Z\",\"locale\":\"ar\"}},{\"id\":15136,\"attributes\":{\"name\":\"is_tod_auto_popup_enabled\",\"value\":\"false\",\"createdAt\":\"2026-06-08T14:09:05.802Z\",\"updatedAt\":\"2026-06-10T13:45:29.931Z\",\"locale\":\"ar\"}},{\"id\":15139,\"attributes\":{\"name\":\"tod_button_proceed\",\"value\":\"تابع\",\"createdAt\":\"2026-06-08T14:13:44.775Z\",\"updatedAt\":\"2026-06-08T14:13:44.775Z\