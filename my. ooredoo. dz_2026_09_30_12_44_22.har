r\",\"value\":\"مكالمات إلى أوريدو\",\"createdAt\":\"2026-08-13T21:23:14.652Z\",\"updatedAt\":\"2026-08-13T21:23:14.652Z\",\"locale\":\"ar\"}},{\"id\":15352,\"attributes\":{\"name\":\"money_national_upper\",\"value\":\"رصيد\",\"createdAt\":\"2026-08-13T21:24:36.292Z\",\"updatedAt\":\"2026-08-13T21:24:36.292Z\",\"locale\":\"ar\"}},{\"id\":15355,\"attributes\":{\"name\":\"sms_home_upper\",\"value\":\"Ooredoo رسائل قصيرة نحو \",\"createdAt\":\"2026-08-13T21:26:43.259Z\",\"updatedAt\":\"2026-08-13T21:26:43.259Z\",\"locale\":\"ar\"}},{\"id\":15358,\"attributes\":{\"name\":\"sms_national_upper\",\"value\":\"الرسائل القصيرة إلى الشبكات الأخرى\",\"createdAt\":\"2026-08-13T21:29:23.373Z\",\"updatedAt\":\"2026-08-13T21:29:23.373Z\",\"locale\":\"ar\"}},{\"id\":15361,\"attributes\":{\"name\":\"voice_national-allnet_upper\",\"value\":\"مكالمات نحو كل الشبكات\",\"createdAt\":\"2026-08-13T21:32:16.907Z\",\"updatedAt\":\"2026-08-13T21:32:16.907Z\",\"locale\":\"ar\"}},{\"id\":15364,\"attributes\":{\"name\":\"cvm_data_FB\",\"value\":\"فايسبوك\",\"createdAt\":\"2026-08-13T21:40:00.877Z\",\"updatedAt\":\"2026-08-13T21:43:10.207Z\",\"locale\":\"ar\"}},{\"id\":15367,\"attributes\":{\"name\":\"data_FB_new_ui_icon\",\"value\":\"/uploads/Facebook_221508cd54.svg\",\"createdAt\":\"2026-08-13T22:12:54.982Z\",\"updatedAt\":\"2026-08-14T08:41:58.885Z\",\"locale\":\"ar\"}},{\"id\":15370,\"attributes\":{\"name\":\"data_FB_new_ui_icon_dark\",\"value\":\"/uploads/Facebook_221508cd54.svg\",\"createdAt\":\"2026-08-13T22:13:58.134Z\",\"updatedAt\":\"2026-08-14T08:41:44.337Z\",\"locale\":\"ar\"}},{\"id\":15373,\"attributes\":{\"name\":\"sms_national_new_ui_icon\",\"value\":\"/uploads/SMS_1_1e01142d74.svg\",\"createdAt\":\"2026-08-13T22:31:16.391Z\",\"updatedAt\":\"2026-08-13T22:31:16.391Z\",\"locale\":\"ar\"}},{\"id\":15376,\"attributes\":{\"name\":\"sms_national_new_ui_icon_dark\",\"value\":\"/uploads/sms_3d21fec75b.svg\",\"createdAt\":\"2026-08-13T22:31:56.772Z\",\"updatedAt\":\"2026-08-13T22:31:56.77