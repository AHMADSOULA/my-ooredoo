butes\":{\"name\":\"0c36554821ff4448a913e6eabd77526598cd99d6\",\"value\":\" اشتراك 30 دقيقة نحو Ooredoo\",\"createdAt\":\"2022-10-31T08:33:43.011Z\",\"updatedAt\":\"2023-03-28T08:24:29.133Z\",\"locale\":\"ar\"}},{\"id\":2081,\"attributes\":{\"name\":\"862bfefa81970e3884d8868d226493036f8bd9c3\",\"value\":\" اشتراك 40 رسالة قصيرة\",\"createdAt\":\"2022-10-31T08:34:19.897Z\",\"updatedAt\":\"2023-03-28T08:24:30.245Z\",\"locale\":\"ar\"}},{\"id\":2084,\"attributes\":{\"name\":\"2582207b9b3a8cad4c450b82964ff228094538a3\",\"value\":\" اشتراك إنترنت 100Mo\",\"createdAt\":\"2022-10-31T08:41:39.383Z\",\"updatedAt\":\"2023-03-28T08:24:31.528Z\",\"locale\":\"ar\"}},{\"id\":2087,\"attributes\":{\"name\":\"b08e763577914a3d409e61f687b742d5671d68e0\",\"value\":\" اشتراك 60 دقيقة نحو كل الشبكات\",\"createdAt\":\"2022-10-31T08:42:25.831Z\",\"updatedAt\":\"2023-03-28T08:24:32.564Z\",\"locale\":\"ar\"}},{\"id\":2090,\"attributes\":{\"name\":\"0585b019ab6000b4d6c044a4a7b533388a2cab72\",\"value\":\" اشتراك 80 دقيقة نحو Ooredoo\",\"createdAt\":\"2022-10-31T08:46:17.516Z\",\"updatedAt\":\"2023-03-28T08:24:34.205Z\",\"locale\":\"ar\"}},{\"id\":2093,\"attributes\":{\"name\":\"d25a57a88492cc6a1a917e0282b9d505c348dd97\",\"value\":\" اشتراك 120 رسالة قصيرة\",\"createdAt\":\"2022-10-31T08:46:59.810Z\",\"updatedAt\":\"2023-03-28T08:24:35.655Z\",\"locale\":\"ar\"}},{\"id\":2096,\"attributes\":{\"name\":\"453d155d32c90f894f76b89935b99f76e00ec612\",\"value\":\" اشتراك إنترنت 300Mo\",\"createdAt\":\"2022-10-31T08:47:46.427Z\",\"updatedAt\":\"2023-03-28T08:24:37.042Z\",\"locale\":\"ar\"}},{\"id\":2099,\"attributes\":{\"name\":\"2afd84d2d5f436c65f1fde8840ac59edd82020a5\",\"value\":\" اشتراك 150 دقيقة نحو كل الشبكات\",\"createdAt\":\"2022-10-31T08:49:14.272Z\",\"updatedAt\":\"2023-03-28T08:24:38.085Z\",\"locale\":\"ar\"}},{\"id\":2102,\"attributes\":{\"name\":\"3d53c33b3f983a87e97daf0ccc8cc397456435a8\",\"value\":\" اشتراك 180 دقيقة نحو Ooredoo\",\"createdAt\":\"2022-10-31T08:49:54.155Z\",\"updatedAt\":