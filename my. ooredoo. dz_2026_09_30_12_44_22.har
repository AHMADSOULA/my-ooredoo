edAt\":\"2023-03-28T08:20:50.139Z\",\"locale\":\"ar\"}},{\"id\":1861,\"attributes\":{\"name\":\"you_will_lose_all_the_points_you_earned_so_far\",\"value\":\"ستخسر كل النقاط التي كسبتها حتى الآن.\",\"createdAt\":\"2022-10-05T06:22:32.829Z\",\"updatedAt\":\"2023-03-28T08:22:53.280Z\",\"locale\":\"ar\"}},{\"id\":1864,\"attributes\":{\"name\":\"subscription_canceled_upper\",\"value\":\"تم إلغاء التسجيل \",\"createdAt\":\"2022-10-05T06:23:39.031Z\",\"updatedAt\":\"2022-10-05T06:23:40.471Z\",\"locale\":\"ar\"}},{\"id\":1866,\"attributes\":{\"name\":\"you_successfully_cancelled_your_ooreedo_quiz_subscription\",\"value\":\"لقد قمت بإلغاء تسجيلك بنجاح في مسابقة Ooreedo Quiz \",\"createdAt\":\"2022-10-05T06:24:53.558Z\",\"updatedAt\":\"2023-03-28T08:22:06.965Z\",\"locale\":\"ar\"}},{\"id\":1868,\"attributes\":{\"name\":\"notification_before\",\"value\":\"الإخطار قبل\",\"createdAt\":\"2022-10-05T06:27:26.075Z\",\"updatedAt\":\"2023-07-18T09:17:40.355Z\",\"locale\":\"ar\"}},{\"id\":1870,\"attributes\":{\"name\":\"challenge_of_the_day\",\"value\":\"تحدي اليوم\",\"createdAt\":\"2022-10-05T06:27:52.536Z\",\"updatedAt\":\"2023-03-28T08:20:54.039Z\",\"locale\":\"ar\"}},{\"id\":1872,\"attributes\":{\"name\":\"answer_simple_question_&_win_daily_rewards\",\"value\":\"أجب عن سؤال بسيط واربح مكافآت يومية\",\"createdAt\":\"2022-10-05T06:29:33.631Z\",\"updatedAt\":\"2023-03-28T08:20:56.896Z\",\"locale\":\"ar\"}},{\"id\":1874,\"attributes\":{\"name\":\"collect\",\"value\":\"جمع\",\"createdAt\":\"2022-10-05T06:30:05.795Z\",\"updatedAt\":\"2023-03-28T08:20:58.351Z\",\"locale\":\"ar\"}},{\"id\":1876,\"attributes\":{\"name\":\"all_incoming_calls_ussd\",\"value\":\"كل المكالمات الواردة {ussd}\",\"createdAt\":\"2022-10-05T06:30:25.228Z\",\"updatedAt\":\"2023-03-28T08:20:59.429Z\",\"locale\":\"ar\"}},{\"id\":1878,\"attributes\":{\"name\":\"a_specific_number\",\"value\":\"رقم محدد\",\"createdAt\":\"2022-10-05T06:31:05.980Z\",\"updatedAt\":\"2023-03-28T08:21:00.797Z\",\"locale\":\"ar\"}},{\"id\":1880,\"attributes\":{\"name\":\"enter_number_upper\",\"value\":\"يرجى إدخال الرقم\",\"createdAt\":\"2022-10-05T06:31:25.341Z\",\"updatedAt\":\"2023-03-28T08:21:02.216Z\",\"locale\":\"ar\"}},{\"id\":1882,\"attributes\":{\"name\":\"redeem_your_noudjoum_points\",\"value\":\"استبدال نقاط نجوم الخاصة بك\",\"createdAt\":\"2022-10-05T06:32:27.998Z\",\"updatedAt\":\"2023-03-28T08:21:03.362Z\",\"locale\":\"ar\"}},{\"id\":1884,\"attributes\":{\"name\":\"you_can_redeem_noudjoum_points_when_purchasing\",\"value\":\"يمكنك استبدال نقاط نجوم عند شراء اشتراكات المكالمات / الإنترنت/ اشتراكات Smart بهدايا مادية عبر تطبيق MyOoredoo\",\"createdAt\":\"2022-10-05T06:34:02.636Z\",\"updatedAt\":\"2023-03-28T08:22:10.033Z\",\"locale\":\"ar\"}},{\"id\":1886,\"attributes\":{\"name\":\"subscribe_to_noudjoum_to_get_rewards_from_ooredoo\",\"value\":\"اشترك في نجوم لتحصل على مكافآت من Ooredoo\",\"createdAt\":\"2022-10-05T06:34:51.132Z\",\"updatedAt\":\"2023-03-28T08:21:40.319Z\",\"locale\":\"ar\"}},{\"id\":1888,\"attributes\":{\"name\":\"earn_noudjoum_points_on_every_spend_on_ooredoo_services\",\"value\":\"اربح نقاط نجوم مقابل كل خدمات Ooredoo\",\"createdAt\":\"2022-10-05T06:35:22.896Z\",\"updatedAt\":\"2023-03-28T08:22:11.679Z\",\"locale\":\"ar\"}},{\"id\":1890,\"attributes\":{\"name\":\"explore_rewards\",\"value\":\"اكتشف المكافآت\",\"createdAt\":\"2022-10-05T06:35:50.665Z\",\"updatedAt\":\"2023-03-28T08:21:37.521Z\",\"locale\":\"ar\"}},{\"id\":1892,\"attributes\":{\"name\":\"redeem_enjoy_and_save\",\"value\":\"استبدل واستمتع ووفر! \",\"createdAt\":\"2022-10-05T06:36:12.035Z\",\"updatedAt\":\"2023-03-28T08:21:36.420Z\",\"locale\":\"ar\"}},{\"id\":1894,\"attributes\":{\"name\":\"looks_like_your_number_is_not_an_ooredoo_number\",\"value\":\"يبدو أن رقمك ليس رقم Ooredoo\",\"createdAt\":\"2022-10-05T06:36:42.753Z\",\"updatedAt\":\"2023-03-28T08:21:34.927Z\",\"locale\":\"ar\"}},{\"id\":1896,\"attributes\":{\"name\":\"nearest_ooredoo_outlets\",\"value\":\"فضاءات Ooredoo الأقرب \",\"createdAt\":\"2022-10-05T06:38:23.423Z\",\"updatedAt\":\"2023-03-28T08:21:27.855Z\",\"locale\":\"ar\"}},{\"id\":1898,\"attributes\":{\"name\":\"do_you_have_the_app\",\"value\":\"هل لديك التطبيق؟\",\"createdAt\":\"2022-10-05T06:39:20.901Z\",\"updatedAt\":\"2023-03-28T08:21:25.181Z\",\"locale\":\"ar\"}},{\"id\":1900,\"attributes\":{\"name\":\"open_app_upper\",\"value\":\"افتح التطبيق\",\"createdAt\":\"2022-10-05T06:40:07.814Z\",\"updatedAt\":\"2023-03-28T08:21:23.515Z\",\"locale\":\"ar\"}},{\"id\":1902,\"attributes\":{\"name\":\"your_account_balance\",\"value\":\"رصيد حسابك\",\"createdAt\":\"2022-10-05T06:41:20.568Z\",\"updatedAt\":\"2023-03-28T08:21:20.997Z\",\"locale\":\"ar\"}},{\"id\":1904,\"attributes\":{\"name\":\"choose_your_genre\",\"value\":\"اختر النوع الخاص بك\",\"createdAt\":\"2022-10-05T06:41:59.921Z\",\"updatedAt\":\"2023-03-28T08:21:19.636Z\",\"locale\":\"ar\"}},{\"id\":1906,\"attributes\":{\"name\":\"your_account_has_a_default_password\",\"value\":\"لحسابك كلمة سر افتراضية\",\"createdAt\":\"2022-10-05T06:42:48.180Z\",\"updatedAt\":\"2023-03-28T08:21:18.469Z\",\"locale\":\"ar\"}},{\"id\":1907,\"attributes\":{\"name\":\"please_set_a_new_password_to_continue\",\"value\":\"يرجى تعيين كلمة سر جديدة للمواصلة\",\"createdAt\":\"2022-10-05T06:43:14.136Z\",\"updatedAt\":\"2023-03-28T08:21:17.261Z\",\"locale\":\"ar\"}},{\"id\":1910,\"attributes\":{\"name\":\"do_you_wish_to_exit_this_process\",\"value\":\"هل ترغب في الخروج من هذه العملية؟\",\"createdAt\":\"2022-10-05T06:45:58.146Z\",\"updatedAt\":\"2023-03-28T08:21:16.203Z\",\"locale\":\"ar\"}},{\"id\":1912,\"attributes\":{\"name\":\"you_will_have_to_follow_all_the_steps_again_to_reset_password\",\"value\":\"سيتعين عليك اتباع جميع الخطوات مرة أخرى لإعادة تعيين كلمة السر\",\"createdAt\":\"2022-10-05T06:46:29.823Z\",\"updatedAt\":\"2023-03-28T08:22:14.519Z\",\"locale\":\"ar\"}},{\"id\":1914,\"attributes\":{\"name\":\"yes_exit_upper\",\"value\":\"نعم، الخروج \",\"createdAt\":\"2022-10-05T06:47:00.338Z\",\"updatedAt\":\"2023-03-28T08:21:13.337Z\",\"locale\":\"ar\"}},{\"id\":1916,\"attributes\":{\"name\":\"bad_luck_try_out_next_question\",\"value\":\"لم يحالفك الحظ! جرب السؤال التالي.\\n\",\"createdAt\":\"2022-10-05T06:47:21.982Z\",\"updatedAt\":\"2023-03-30T12:05:31.281Z\",\"locale\":\"ar\"}},{\"id\":1918,\"attributes\":{\"name\":\"well_done_continue_answering_correctly_to_increase_your_points_and_win_let_us_try_the_next_question\",\"value\":\"أحسنت! استمر في الإجابة بشكل صحيح لكسب المزيد من النقاط والفوز. لنجرب السؤال التالي!\",\"createdAt\":\"2022-10-05T06:47:52.904Z\",\"updatedAt\":\"2023-03-28T08:22:15.575Z\",\"locale\":\"ar\"}},{\"id\":1920,\"attributes\":{\"name\":\"choose_the_correct_answer_by_tapping_on_one_of_the_answers_below\",\"value\":\"اختر الإجابة الصحيحة من خلال الضغط على إحدى الإجابات أدناه\",\"createdAt\":\"2022-10-05T06:53:49.718Z\",\"updatedAt\":\"2023-03-28T08:22:16.653Z\",\"locale\":\"ar\"}},{\"id\":1922,\"attributes\":{\"name\":\"shift _to_ooredoo_today\",\"value\":\"قم بالتغيير إلى Ooredoo اليوم\",\"createdAt\":\"2022-10-05T06:54:18.721Z\",\"updatedAt\":\"2023-03-28T08:21:10.217Z\",\"locale\":\"ar\"}},{\"id\":1924,\"attributes\":{\"name\":\"order_new_sim_upper\",\"value\":\"أطلب بطاقة SIM جديدة\",\"createdAt\":\"2022-10-05T06:54:37.920Z\",\"updatedAt\":\"2023-03-28T08:21:07.293Z\",\"locale\":\"ar\"}},{\"id\":1926,\"attributes\":{\"name\":\"now\",\"value\":\"الآن \",\"createdAt\":\"2022-10-05T06:54:59.826Z\",\"updatedAt\":\"2023-03-28T08:21:05.915Z\",\"locale\":\"ar\"}},{\"id\":1929,\"attributes\":{\"name\":\"password\",\"value\":\"كلمة السر\",\"createdAt\":\"2022-10-05T07:32:51.836Z\",\"updatedAt\":\"2023-03-28T08:22:54.455Z\",\"locale\":\"ar\"}},{\"id\":1933,\"attributes\":{\"name\":\"user_already_exists\",\"value\":\"المستخدم موجود اصلا\",\"createdAt\":\"2022-10-05T12:07:13.586Z\",\"updatedAt\":\"2023-03-28T08:22:57.321Z\",\"locale\":\"ar\"}},{\"id\":1936,\"attributes\":{\"name\":\"ooredoo_algeria_quiz_terms_of_use_statement\",\"value\":\"« Quiz Ooredoo » قوانين مسابقة\\n \\nالمادة 1: «Numbase» شركة مسجلة في السجل التجاري 180487 في لبنان، الكائن مقرها في مجمع العازارية، المبنى 3، الطابق الثالث، بيروت، لبنان، المشار إليها أدناه بـ \\\"المنظم\\\"\\nتنظّم بالشراكة مع الشركة الوطنية للاتصالات الجزائر، المعروفة باسم علامتها التجارية \\\"Ooredoo\\\"، المشار إليها فيما بعد بـ \\\"الشريك\\\"، مسابقة للمشتركين الحاليين والجدد لدى Ooredoo على التراب الوطني الجزائري، المشار إليهم فيما بعد بـ \\\"المشارك\\\" (المشاركين).\\nيتم النص على شروط المشاركة في المسابقة وتسمية الفائزين في هذه القوانين المشار إليها بـ \\\"القوانين\\\". \\nتقتضي المشاركة في المسابقة، المشار إليها فيما بعد بـ \\\"العملية\\\" القبول الكامل لهذه القوانين. \\nيعمل المنظم وشريكه على تقديم المساعدة التقنية اللازمة من أجل ضمان السير الحسن للعملية.\\nالمادة 2: مبدأ العملية \\nالعملية عبارة عن لعبة تسمى \\\"Quiz Ooredoo\\\" وهي عبارة عن مجموعة من الأسئلة مع قائمة من الإجابات لكل مجموعة يتم تقديمها للمشارك الذي سيتعين عليه اختيار أكبر عدد من الإجابات الصحيحة من أجل زيادة فرصه في الفوز بالجوائز المنصوص عليها في المادة 6. \\nمن خلال الإجابة على أكبر عدد من الإجابات الصحيحة، سيزيد المشارك من فرصه في الفوز بالجوائز المنصوص عليها في المادة 6. \\nيمكن للمشاركين المشاركة في العملية عن طريق إرسال رسالة قصيرة إلى الرقم 5005 و / أو على تطبيق الهاتف المحمول \\\"Quiz Ooredoo\\\" المتوفر في App Store و Play Store. \\nالمادة 3: المدة \\nتم تمديد المشاركة في العملية لمدة 90 يومًا إضافية، حيث تبدأ المسابقة بتاريخ2026/02/23 وتنتهي بتاريخ 23/05/2026 \\nيمكن للمشاركين المسجلين في المسابقة أن يواصلوا المشاركة دون انقطاع ودون خسارة النقاط التي جمعوها إلى غاية2026/05/23  على الساعة 23:59.\\n\\nالمادة 4: المشاركون \\nالعملية مفتوحة لأي شخص بالغ أو قاصر، مقيم في الجزائر، يستخدم بيانات 2G / 3G / 4G من Ooredoo، وقد اشترك في لعبة Quiz Ooredoo ولديه خط Ooredoo شخصي وذلك لأغراض تحديد الهوية. \\nيسُمح للقاصرين بالمشاركة في هذه اللعبة، للفوز بالجائزة اليومية فقط، شرط أن يكونوا قد حصلوا مسبقا على إذن صريح من قبل والديهم أو الشخص الذي يمارس السلطة الأبوية عليهم للقيام بذلك. مشاركتهم تعني أنهم حصلوا على ترخيص مسبق. \\nبالنسبة للمشاركين القاصرين، يجب أن يكون خط Ooredoo مسجل باسم الوصي القانوني. \\nيستثنى من هذه العملية موظفو الشركة المنظمة وموظفو الشركات المشاركة أو الذين شاركوا في تصميم وتنظيم وتنفيذ العملية وأفراد أسرهم (الوالدين والإخوة والأخوات أو أي شخص آخر مقيم في المنزل نفسه). كما يستثنى من المسابقة الفائزون الذين حصلوا على الجائزة الأسبوعية في إطار مسابقة Quiz Ooredoo، أو الهدية الكبرى لـ Quiz Maison وDari Quiz، QuizUp  أو الفائزون بالسيارة.\\nيحتفظ المنظم وشريكه بحق مطالبة أي مشارك بتبرير شروط أهليته للعبة. أي مشارك لا يستوفي هذه الشروط أو يرفض تبريرها سيتم استبعاده من العملية ولن يتمكن، في أي حال، من الاستفادة من أي جائزة، من دون أن يؤدي هذا الاستبعاد إلى التعويض. \\nلضمان الامتثال لهذه القواعد، يحتفظ المنظم بالحق في إجراء أي تحقق ضروري. أي دلالة زائفة أو احتيالية أو خاطئة أو مضللة أو غير صحيحة أو غير دقيقة للهوية أو العنوان ستؤدي إلى إلغاء المشاركة. \\nسيتم استبعاد المشاركين الذين لم يقدموا تفاصيلهم الكاملة وهوياتهم أو الذين قدموها بشكل غير دقيق أو مضلل، وكذلك المشاركين الذين رفضوا جمع وتسجيل واستخدام المعلومات الشخصية المتعلقة بهم واللازمة لاحتياجات إدارة العملية. لن يتم استخدام البيانات إلا في سياق العملية المذكورة. \\nتقتضي المشاركة في العملية القبول غير المشروط لهذه القوانين، بجميع أحكامها وكذلك القوانين والقواعد المعمول بها في هذا المجال على التراب الوطني الجزائري. \\nيؤدي عدم الامتثال لشروط المشاركة المنصوص عليها في القواعد إلى إلغاء المشاركة. \\nخلال مدة العملية، يمكن للمشاركين الحصول يوميا ومجانًا على معلومات في الثقافة العامة عن طريق الرسائل القصيرة. \\nيمكن للمشارك أن يلغي أو يوقف استقبال هذه الرسائل القصيرة دون أن يؤثر ذلك على مشاركته في العملية. \\n\\nالمادة 5: شروط وأحكام المشاركة \\n5.1 شروط المشاركة\\nللمشاركة في العملية، يجب على المشارك: \\n•\\tالحصول على هاتف نقال وخط Ooredoo بموجب عقد اشتراك صالح؛ \\n•\\tالمشاركة في لعبة\\\" Quiz Ooredoo\\\" خلال المدة المذكورة أعلاه، وإمكانية التحقق منها على النظام.\\nتتم المشاركة عن طريق إرسال رسالة قصيرة إلى الرقم 5005 و/أو عبر تطبيق الهاتف المحمول\\\" Quiz Ooredoo\\\" من خلال استكمال عملية التحقق بنجاح. يجب على المشارك الاطلاع على القوانين الحالية لغرض قبولها. سيتلقى الزبون الرسالة القصيرة الأولى أو الرسالة الإعلامية من المنظم (رسالة قصيرة أو رسالة ترحيب)، وسيتلقى المشارك بعد ذلك رسائل قصيرة أو رسائل أخرى تقدم له معلومات عن مسار اللعبة؛ \\n- أن يكون لديه رصيد هاتف بقيمة 25 دج على الأقل لكل يوم مشاركة في العملية. يتم استثناء المكافآت والفوائد الأخرى التي يمنحها الشريك لمشتركيه من الرصيد في إطار هذه القوانين.  \\n5.2 شروط المشاركة \\nبعد الاشتراك في العملية وعند قبول هذه القواعد، سيتم خصم 25 دج تلقائيا من رصيد المشارك لكل يوم مشاركة وذلك طوال مدة المشاركة في العملية، ما لم يقم المشارك بإلغاء الاشتراك كما هو موضح أدناه. بعد ذلك، سيتلقى المشارك مجموعة يومية من الأسئلة عبر رسائل قصيرة أو عبر التطبيق، وفقا لطريقة المشاركة. بعد كل إجابة، يتلقى المشارك السؤال التالي الذي يتعين عليه الإجابة عليه لكي يتلقى بعد ذلك السؤال الموالي. تتضمن مجموعة الأسئلة التي يتم تلقيها يوميا خلال المشاركة 30 سؤالًا كحد أقصى. \\nسيتعين على المشارك اختيار الإجابة الصحيحة من بين الاقتراحات التي سيتم تقديمها له عن طريق إرسال رقم ترتيب الإجابة الصحيحة عبر رسالة قصيرة إلى الرقم 5005 أو عبر رسالة على التطبيق. إرسال الرسائل القصيرة أو الرسائل على التطبيق مجاني. \\nتشمل العملية نوعين من الجوائز: \\n•\\tجائزة يومية تتعلق بالأسئلة اليومية طوال مدة العملية \\n•\\tجائزة أسبوعية تتعلق بالأسئلة المقدمة كل يوم سبت طوال مدة العملية، شرط المشاركة ليوم واحد على الأقل خلال الأسبوع المعين. \\n\\n\\n5.3 توزيع ونقل النقاط \\nكل إجابة صحيحة تمنح عدد من النقاط التي يتم إرسالها في كل مرحلة. يمكن للمشارك إرسال كلمة \\\"مساعدة\\\" مجانًا عبر رسالة قصيرة إلى الرقم 5005 لتلقي المساعدة إذا احتاجها. الإجابات الخاطئة تعطي أيضا نقاطا للمشاركين. \\nسيتمكن المشاركون أيضا من معرفة رصيد نقاطهم الحالية عن طريق إرسال كلمة \\\"نقاط\\\" عبر رسالة قصيرة إلى 5005 أو رسالة عبر التطبيق. إرسال واستقبال رسائل الرد مجاني.  \\nبالنسبة للجوائز اليومية، سيتم الاحتفاظ بكل النقاط التي جمعها المشارك في حساب نقاطه الشخصية حتى بعد إلغاء اشتراكه (طوال مدة اللعبة). ويعني ذلك أنه حتى لو فاز بالجائزة اليومية، يمكنه استخدام النقاط المتراكمة للمشاركة الأسبوعية القادمة.  \\nويعني ذلك أيضا أنه في حالة عدم فوز المشارك بالجائزة اليومية، سيتم الاحتفاظ بالنقاط المتراكمة لليوم والأسبوع المقبل لكي يتمكن المشارك من زيادة فرصه في الفوز بالجائزة اليومية. \\nكذلك، إذا لم يكن لدى المشارك رصيد كافٍ للاستمرار في اللعب، فسيبقى بإمكانه اللعب ليومين على التوالي دون دفع رسوم الاشتراك اليومي المقدرة بـ 25 دج. في اليوم الثالث، يتلقى المشارك إشعارًا يطلب منه دفع رسوم اشتراك اليومين السابقين لمواصلة اللعب. في حالة ما لم يقم المشارك بالدفع، ولكنه فاز بالجائزة، فيتعين عليه تسوية وضعه من خلال تسديد الدفعات الضرورية في غضون فترة 5 أيام بعد إرسال الإشعار إليه. إن لم يفعل ذلك، سيفقد المشارك حقه في الفوز. \\nبالنسبة للجوائز الأسبوعية، لن يتم احتساب نقاط المشاركين المتراكمة خلال أسبوع للأسبوع التالي ولكن سيتم احتسابها للجوائز اليومية في الأسابيع المتتالية كافة حتى يربح المشارك الجائزة اليومية. \\nسيتمكن جميع المشاركين من المشاركة في الأسئلة الأسبوعية مع كل النقاط التي جمعوها خلال كل الفترة الأسبوعية (من يوم الأحد من الساعة 00:00 حتى يوم السبت في الساعة 23:59).\\nلا تعتمد ميزة 100Seconds على نظام النقاط. حيث لا يؤثر الأداء في هذه اللعبة على رصيد النقاط التي تم جمعها في Quiz Ooredoo. إذ تعتمد آلية الفوز في 100Seconds على النجاح المباشر في تحدي 10 أسئلة في غضون 100 ثانية، بدون نقاط متراكمة.\\n5.4 إلغاء الاشتراك : \\nإذا رغب أحد المشاركين في إلغاء الاشتراك من العملية وعدم تلقي أي أسئلة أخرى، فسيتعين عليه إرسال رسالة قصيرة إلى 5005 أو رسالة على التطبيق تتضمن كلمة \\\"STOP\\\". بعد ذلك، سيتلقى المشارك رسالة قصيرة أو رسالة تؤكد أن رقم هاتفه النقال لم يعد يشارك في اللعبة ولن يتلقى بعد ذلك أي أسئلة متعلقة باللعبة. \\nيمكن للمشاركين في أي وقت إعادة التسجيل مرة أخرى باتباع الإجراء المذكور أعلاه. \\nالمادة 6 :  « 100Seconds » المبدأ، طريقة اللعب والدخول:\\n 100Seconds هو لعبة تعتمد على السرعة، حيث يجب على المشارك الإجابة بشكل صحيح على 10 أسئلة متتالية خلال أقل من 100 ثانية.\\nتُعد هذه اللعبة امتدادًا لخدمة Quiz Ooredoo ، حيث يمكن لجميع المشاركين في 100Seconds الدخول مجانًا إلى Quiz Ooredoo، والعكس صحيح. كلا الخدمتين مكملتان لبعضهما البعض لكنهما مستقلتان: لا يتطلب 100Seconds جمع نقاط، بخلاف المسابقة الرئيسية.\\nيبدأ التحدي تلقائيًا مع أول سؤال، مع تشغيل عدٍّ تنازلي من 100 ثانية.\\nفي حال النجاح، يتلقى المشارك فورًا عبر رسالة نصية قصيرة (SMS) قسيمة شراء من JUMIA بقيمة 50,000 دج، صالحة لمدة 3 أشهر من تاريخ الاستلام.\\nلا تُفرض أي رسوم على المشاركين في Quiz Ooredoo، ويمنحهم الدخول إلى لعبة 100Seconds محاولتين مجانيتين.\\nاللعبة متاحة عبر الصفحة المخصصة:\\nwww.ooredooquiz.com\\nالمادة 7: تفاصيل الربح وشروط تسليم الجوائز: \\nفي نهاية العملية، يقدم المنظم للمشاركين الفائزين الهدايا التالية: \\nالجوائز اليومية: \\nقسيمة شراء كل يوم، باستثناء الأيام المتعلقة بالأسئلة الأسبوعية عبر الرسائل القصيرة طيلة مدة العملية.\\nالجوائز الاسبوعية: \\nهدية رائعة كل سبت، حيث سيتم على العموم تسليم 12 هدية على الأقل طوال مدة العملية. \\nبالنسبة للجوائز اليومية، إذا رفض الفائز الحصول على الجائزة أو لم يتمكن المنظم من الاتصال به/الوصول إليه خلال مدة ثلاثين (30) يوما بعد تحديد جائزته، ستنتقل الجائزة إلى المشارك الذي حصل على المركز الثاني في قائمة المسابقات المعنية. سيتم تسمية هذا المشارك بصاحب المركز الثاني. إذا رفض أيضا صاحب المركز الثاني الجائزة أو فشل المنظم في الاتصال به أو الوصول إليه، فسيحصل على الجائزة صاحب المركز الثالث. في حالة استحالة الحصول على الجائزة من قبل المتأهلين اللاحقين أيضا، ينتقل حق استلام الجائزة إلى المركز التالي، حتى يتم تحديد الفائز. بالنسبة للجوائز الأسبوعية، إذا رفض الفائز الحصول على الجائزة أو لم يتمكن المنظم من الاتصال به/الوصول إليه في غضون ثلاثين (30) يوما بعد تحديد جائزته، ستنتقل الجائزة إلى المشارك الذي أمّن له عدد النقاط الذي جمعه المركز الثاني في الفترة الزمنية المعينة. سيتم تسمية هذا المشارك بصاحب المركز الثاني. إذا رفض أيضا صاحب المركز الثاني الجائزة أو فشل المنظم في الاتصال به أو الوصول إليه، فسيحصل على الجائزة صاحب المركز الثالث الذي أكسبه مجموع النقاط الذي جمعه المركز الثالث في الفترة الزمنية المعنية. في حالة استحالة الحصول على الجائزة من قبل المتأهلين اللاحقين أيضا، ينتقل حق استلام الجائزة إلى المركز التالي، حتى يتم تحديد الفائز. \\nبالإضافة إلى الجوائز المذكورة أعلاه، يتم منح جوائز فورية كجزء من امتداد لعبة 100Seconds.\\nوتكون هذه الجوائز عبارة عن قسيمات Jumia بقيمة 50,000 دج، يتم إرسالها عن طريق رسالة نصية قصيرة فور إتمام التحدي بنجاح وفقًا للشروط المنصوص عليها في المادة 17.\\nهذه القسيمات شخصية وصالحة لمدة 3 أشهر، ابتداءّ من تاريخ استلام الرمز عبر رسالة نصية قصيرة. كما أنها لا تتطلب أي مصادقة لاحقة من قبل المنظم.\\nالمادة 8: تسمية الفائزين ومنح الجوائز \\n1.8 الجائزة اليومية - مسابقة \\\"أكبر عدد من النقاط\\\" (Quiz Ooredoo) \\nتُمنح الجوائز اليومية لخدمة Quiz Ooredoo للمشارك الذي جمع أكبر عدد من النقاط في اليوم المعني.\\nفي حالة التعادل بين اثنين من المشاركين أو أكثر (بنفس عدد النقاط)، سيكون الفائز هو من أحرز أعلى عدد من النقاط أولاً. سيتم إعلام الفائزين عن طريق رسالة نصية قصيرة. وسيتم بعد ذلك إرسال قسيمة Jumia بقيمة 000 50 دج في غضون 3 أشهر كحد أقصى ابتداءً من تاريخ إعلان النتائج. كل قسيمة صالحة لمدة 3 أشهر بعد الاستلام، والرمز الخاص بها شخصي وغير قابل للتحويل. \\n2.8 الجائزة الأسبوعية (مسابقة \\\"أكبر عدد من النقاط\\\") \\nسيتم الفوز بالجائزة الأسبوعية من قبل المشارك الذي اشترك ودفع مرة واحدة على الأقل مقابل الأسئلة الأسبوعية (كل سبت) والذي حصد المركز الأول من خلال جمع أكبر عدد من النقاط خلال كل فترة من الفترات الأسبوعية (من يوم الأحد على الساعة 01: 00 إلى غاية يوم السبت على الساعة 23:59). \\nإذا حصل اثنان أو أكثر من المشاركين على نفس النتيجة (جمع اثنان أو أكثر من المشاركين نفس عدد النقاط)، فسيتم اعتبار المشارك الأول الذي جمع أكبر عدد من النقاط في (أسرع وقت) الفائز بالجائزة المعنية. \\nسيتم إعلام الفائزين بجوائزهم عن طريق الاتصال أو الرسائل القصيرة من قبل Ooredoo \\nسيقوم المنظم بإبلاغ الفائزين عن مسار الأحداث: \\nسيتم تسليم الهدايا اليومية) قسيمات الشراء (للفائزين خلال 4 أشهر أو أكثر من تاريخ الإعلان عن نتائج المسابقة.\\nسيتم تسليم الهدايا الأسبوعية للفائزين خلال 8 أشهر أو أكثر من تاريخ الإعلان عن نتائج المسابقة.\\n\\nسيتلقى الفائزين بعد تعيينهم قسيمة شراء عبر رسالة قصيرة. بعد استلام القسيمة، سيتلقى الفائز مكالمة من قبل خدمة الزبائن لشرح كيفية استخدام القسيمة. تقدر صلاحية القسيمة بـ 6 أشهر من تاريخ استلامها، حيث سيتم إلغاؤها بعد 6 أشهر من عدم استخدامها. خلاف ذلك، سيقوم المنظم باستبدال الفائز بمشارك آخر وفقًا للترتيب المتحصل عليه في النتيجة النهائية.\\nيمكن للمشارك الفوز بجائزة يومية واحدة فقط، ولكن يمكنه أيضا الحصول على جائزة أسبوعية. \\nيمكن للمشارك الفوز بجائزة أسبوعية واحدة فقط. \\n3.8 الجائزة الفورية - مسابقة ” “100Seconds\\nكجزء من الميزة ”100Seconds\\\"، يمكن للمشاركين الذين يجيبون بشكل صحيح على 10 أسئلة في غضون 100 ثانية الحصول على جائزة فورية، وهي رمز قسيمة Jumia بقيمة     000 50 دج. حيث تُمنح هذه الجائزة مباشرة فور الانتهاء من التحدي بنجاح، ويتم إرسالها عبر رسالة نصية قصيرة دون أي تدخل يدوي أو وقت انتظار. كل رمز صالح لمدة 3 أشهر من تاريخ الاستلام ويظل شخصيًا تمامًا.\\n4.8 القواعد العامة للحصول على القسيمة\\nلا يمكن للمشارك الفوز سوى بقسيمة يومية واحدة فقط كجزء من Quiz Ooredoo، ولكن يمكنه المشاركة في العديد من تحديات ”100Seconds“. كما يمكن للمشارك أن يفوز بكل من جائزة \\\"Quiz Ooredoo\\\" وجائزة \\\"100Seconds\\\"معًا إذا استوفى الشروط الخاصة بكل منهما. \\nإذا لم يتم استخدام القسيمة خلال الوقت المخصص لها، فسيتم إلغاء تفعيلها تلقائياً، دون أي تعويض محتمل.\\n5.8 المسؤولية المتعلّقة بالقسيمات\\nكل قسيمة شراء (voucher) صادرة عن منصة JUMIA في إطار هذه العملية، سواء من خلال لعبة Quiz Ooredoo أو امتدادها 100Seconds، تعتبر شخصية وغير قابلة للتحويل، ومخصصة للاستخدام من طرف الفائز الذي تم إبلاغه رسمياً.\\nيتم إرسال رمز القسيمة عبر رسالة نصية قصيرة (SMS)، ويتحمل المشارك كامل المسؤولية في الحفاظ عليه. لا تتحمل الجهة المنظمة أي مسؤولية في حال مشاركة الرمز مع طرف ثالث، سواء بشكل متعمد أو عن طريق الخطأ، ولا في حالات الاستخدام الاحتيالي أو الفقدان أو السرقة.\\nلا يمكن طلب أي تعويض أو استبدال في حال استخدام القسيمة من طرف شخص غير الفائز، أو خارج فترة الصلاحية المحددة. ويكون المشارك مسؤولاً بالكامل عن سرية الرمز فور استلامه.\\nومن أجل ضمان تجربة عادلة ومتوازنة لجميع المشتركين، يُوضح أنه يمكن استخدام قسيمة شراء واحدة فقط لكل حساب JUMIA شهرياً. يهدف هذا الإجراء إلى إعطاء فرصة متساوية للجميع للاستفادة من الجوائز، في إطار من الشفافية والعدالة.\\nولهذا الغرض، تم اعتماد نظام للكشف عن الغش تحت إشراف مشترك بين منصة JUMIA وWataniya Télécom Algérie (WTA)، والذي يقوم بالكشف تلقائيًا عن أي استخدام مكرر لعدة رموز فائزة على نفس الحساب في JUMIA. وفي حال حدوث ذلك، سيتم اعتماد أول رمز مفعل فقط، بينما تُلغى باقي القسائم تلقائيًا.\\nيأتي هذا الإجراء في إطار حرص الجهة المنظمة على الحفاظ على مصداقية المسابقة، ومنع أي استغلال غير مشروع قد يؤثر على فرص باقي المشتركين. وهو يعكس مبدأ \\\"فائز واحد = قسيمة واحدة في الشهر\\\" بشكل عادل ومحفز.\\nالمادة 9: المسؤولية بالنسبة للجوائز \\nفيما يتعلق بالجوائز، تعمل الشركة المنظمة على تسليم جوائز جديدة، مضمونة ومتوافقة مع المعايير الخاضعة لها. \\nلا يعتبر المنظم وشريكه ممونين أو بائعين أو موزعين للجوائز (تقتصر مسؤوليتهم على الفعل القانوني لتسليمها) ولا يتحملون أي مسؤولية تعاقدية عن النقل أو الأداء السليم أو الاستعمال أو سلامة الاستخدام و / أو الاستخدام والتمتع بالجوائز الممنوحة. \\nونتيجة لذلك، فإنها لا تتحمل أية مسؤولية عن عدم رضا الفائزين عن الجوائز الخاصة بهم. \\nلا تتحمل الشركة المنظمة أية مسؤولية، في حال وجود قوة قاهرة أو أحداث خارجة عن سيطرتها، تؤدي إلى تعطيل تنظيم وتسيير اللعبة، وتؤدي إلى تقصير أو تمديد أو تأجيل أو تعديل أو إلغاء اللعبة. \\nفي مثل هذه الظروف، ستقوم الشركة المنظمة بتسطير وسائل تقنية معقولة لإبلاغ المشاركين. \\nالمادة 10: القوة القاهرة \\nلا يتحمل المنظم مسؤولية ما إذا كانت العملية، لأسباب خارجة عن إرادته و / أو في حالة القوة القاهرة، بمعناها الأوسع، قد تم تقصيرها أو تعديلها أو تأجيلها أو إلغائها؛ وذلك دون أي تعويض مستحق للمشاركين. \\nلا يمكن تحميل المسؤولية عن هذا الأمر للمنظم. \\nالمادة 11: الإعلان \\nيرخص كل المشاركين المنظم وشريكه Ooredoo بإعادة استخدام الاسم واللقب ومكان الإقامة الخاص بهم التي أرسلوها في إطار مشاركتهم على موقع العملية، بالإضافة إلى حق الاستخدام السمعي والبصري لعملية تسليم الجوائز. \\nسيتم استخدام البيانات الشخصية فقط في إطار اللعبة المذكورة. \\nبالنسبة للقاصرين، يجب أن يتم ذلك بموافقة الوصي القانوني. \\nإذا اعترض أحد المشاركين على استخدام بيانات الاتصال الخاصة به، فيتوجب عليه إبلاغ المنظم دون تأخير عن طريق إرسال رسالة إلى العنوان التالي: 66، طريق أولاد فايت، الشراقة - الجزائر. \\n\\nالمادة 12: المسؤولية \\nتجدر الإشارة إلى أن شبكة الإنترنت ليست آمنة. وبالتالي، لا يمكن اعتبار المنظم مسؤولا عن التعرض لفيروسات محتملة أو تدخل طرف ثالث في نظام المحطة الطرفية للمشاركين في العملية، ويتنازل عن كل المسؤولية عن العواقب المترتبة على اتصال المشاركين بالشبكة عبر موقع الإنترنت لأسباب لا تتعلق بشكل مباشر وحصري بالمنظم.  \\nلا يمكن تحميل المنظم المسؤولية في حالة حدوث خلل في شبكة الإنترنت، وخاصة بسبب أعمال الاحتيال الخارجية، التي من شأنها أن تمنع التقدم الجيد للعملية. \\nعلى وجه التحديد، إذا اتخذ المنظم كافة الاحتياطات الضرورية لا يمكن أن يكون مسؤولا عن أي ضرر ناتج عن المشاركين ومعدات الكمبيوتر الخاصة بهم وبياناتهم المخزنة، كما لا يمكن أن يكون مسؤولا عن الآثار المحتملة التي قد تصيب نشاطهم الشخصي أو المهني، باستثناء حالة الخطأ المباشر والحصري للمنظم. \\nلا يمكن تحميل المنظم المسؤولية في حالة عدم تمكن مشارك واحد أو أكثر من الاتصال بموقع العملية أو المشاركة بسبب أي مشكلة أو عيب فني يتعلق بشكل خاص بتشبع الشبكة أو بسبب أعمال احتيال، يتعهد المنظم بتأمين جميع الوسائل اللازمة لتسهيل اتصال المشاركين. \\nإذا كانت الشركة المنظمة تبذل قصارى جهدها لتقديم معلومات و\\\\أو أدوات دقيقة للمستخدمين، فلا يمكن اعتبارها مسؤولة عن الأخطاء المادية ووجود الفيروسات على الموقع. المشاركة في المسابقة تعني معرفة وقبول خصائص وحدود الإنترنت، وعدم وجود حماية لبعض البيانات من احتمال إساءة الاستخدام أو القرصنة ومخاطر الإصابة بالفيروسات المنتشرة على الشبكة. الأمر يعود لكل مشارك لاتخاذ كل التدابير المناسبة لحماية البيانات الخاصة به و\\\\أو البرامج المخزنة على الهاتف وأجهزة الكمبيوتر الخاصة به ضد أي انتهاك. إن استخدام أي شخص للموقع والمشاركة في اللعبة يقع على مسؤوليته وحده. \\nالمشاركون الذين يحاولون المشاركة عن طريق المشاركة الأوتوماتيكية والبرامج المتوفرة لذلك واستخدام معلومات وأرقام هواتف أخرى، وبشكل عام كل الوسائل غير المتوافقة مع احترام مبدأ تكافؤ الفرص بين المشاركين، سيتم استبعادهم تلقائيا. \\nالمادة 13: الإقصاء \\nيعتبر الغش أو محاولة الغش من قبل مشارك واحد أو أكثر من أجل تغيير النتيجة النهائية بهدف الفوز، غير قانوني ومخالف لمبدأ تكافؤ الفرص. \\nفي هذه الحالات، يحتفظ المنظم بالحق في استبعاد المحتال (المحتالين) من النتيجة النهائية لهذه العملية. \\nقد يؤدي أي احتيال أو عدم امتثال لهذه القواعد إلى استبعاد الشخص من اللعبة، حيث تحتفظ الشركة المنظمة، عند الاقتضاء، بالحق في اتخاذ إجراء قانوني ضده. \\nكما يؤدي استخدام أي آلات ذاتية التشغيل أو برامج مصممة للمشاركة الآلية أو أي وسيلة أخرى منافية لمبدأ تكافؤ الفرص ولروح المشاركة في المسابقة بهدف تشويه النتيجة أو التحايل على كيفيات المشاركة المحددة في القوانين الحالية، إلى الإقصاء الفوري والنهائي من المسابقة، ويشمل ذلك على سبيل المثال لا الحصر أي مستخدم ينتهج سلوك احتيالي ومانع للمنافسة. \\nيحق للمنظم اتخاذ الإجراءات اللازمة للحفاظ على نزاهة المشاركة في المسابقة.\\n يحق للمنظم تعديل القائمة النهائية للفائزين إذا لزم الأمر. \\n\\nالمادة 14: القوانين \\nيمكن الرجوع إلى هذه القوانين طوال مدة اللعبة على الصفحة الرسمية لـ Ooredoo الجزائر وشبكات التواصل الاجتماعي الخاصة بها وقوانين اللعبة في الشروط العامة للاستعمال.  \\nالمادة 15: الملكية الفكرية \\nيعتبر هذا المفهوم وكذلك جميع عناصر هذه العملية والتصميم والعلامات التجارية والشعارات بمثابة ملكية خاصة للمنظم والشريك. يحظر تماما إعادة إنتاج أو استخدام أو استغلال كل هذه العناصر أو جزء منها. \\nالمادة 16: تعديل القوانين \\nتحتفظ الشركة المنظمة بالحق، إذا اقتضت الظروف ذلك، في تعديل أو تقصير أو تمديد أو إلغاء اللعبة، ولا يمكن تحميلها مسؤولية ذلك. \\nتحتفظ الشركة المنظمة بحق تعديل كل هذه القوانين أو جزء منها. وسيتم الإعلان عن أي تغييرات في القوانين على الصفحات الرسمية للمنظم وشريكه وعلى شبكات التواصل الاجتماعي وعلى الموقع الرسمي. \\n\\nالمادة 17: النزاعات \\nينبغي تقديم أي طعن أو شكوى متعلقة بهذه المسابقة إلى شركة الوطنية للاتصالات الجزائر وذلك بالاتصال بمصلحة الزبائن على الرقم 333 أو بالتوجه إلى فضاءات Ooredoo.\\n\\nيتعين على المنظم وشريكه الفصل في أية مسائل متعلقة بتطبيق هذه القوانين وفقًا للتشريعات الجزائرية. \\n\\nينبغي أن يخضع أي نزاع ينجم عن المسابقة إلى محاولة تسوية ودية. وفي حالة تعذر ذلك، يلجأ الطرفان إلى تحكيم سلطة ضبط البريد والاتصالات الإلكترونية (ARPCE).\\n\\nفي حالة تعذر التسوية الودية للنزاع بين الطرفين، يتم إسناد الاختصاص إلى محكمة الشراقة باستثناء أحكام أخرى منافية متعلقة بالنظام العام. \\n\\nلن يتم قبول أي طعن بعد اختتام المسابقة.  \",\"createdAt\":\"2022-10-05T12:15:59.364Z\",\"updatedAt\":\"2026-03-20T19:24:01.819Z\",\"locale\":\"ar\"}},{\"id\":1939,\"attributes\":{\"name\":\"remaining_money_upper\",\"value\":\"المال المتبقي\",\"createdAt\":\"2022-10-06T03:21:01.208Z\",\"updatedAt\":\"2024-03-11T12:42:03.484Z\",\"locale\":\"ar\"}},{\"id\":1941,\"attributes\":{\"name\":\"unlimited_calls\",\"value\":\"مكالمات غير محدودة\",\"createdAt\":\"2022-10-06T03:22:13.082Z\",\"updatedAt\":\"2023-03-28T08:23:01.507Z\",\"locale\":\"ar\"}},{\"id\":1947,\"attributes\":{\"name\":\"email_address_upper\",\"value\":\"عنوان البريد الالكترونى\",\"createdAt\":\"2022-10-06T04:46:59.325Z\",\"updatedAt\":\"2023-03-28T08:23:04.046Z\",\"locale\":\"ar\"}},{\"id\":1951,\"attributes\":{\"name\":\"sunrise\",\"value\":\"شروق الشمس\",\"createdAt\":\"2022-10-06T04:51:42.119Z\",\"updatedAt\":\"2023-03-28T08:23:07.101Z\",\"locale\":\"ar\"}},{\"id\":1953,\"attributes\":{\"name\":\"sunset\",\"value\":\"غروب الشمس\",\"createdAt\":\"2022-10-06T04:52:09.045Z\",\"updatedAt\":\"2023-03-28T08:23:05.497Z\",\"locale\":\"ar\"}},{\"id\":1955,\"attributes\":{\"name\":\"amount\",\"value\":\"المبلغ\",\"createdAt\":\"2022-10-06T06:02:58.860Z\",\"updatedAt\":\"2023-03-28T08:23:08.602Z\",\"locale\":\"ar\"}},{\"id\":1959,\"attributes\":{\"name\":\"insufficient_credit_balance_please_recharge_to_convert_bundle\",\"value\":\"رصيد ائتماني غير كاف. يرجى إعادة الشحن لتحويل الباقة.\",\"createdAt\":\"2022-10-07T02:59:49.458Z\",\"updatedAt\":\"2023-03-28T08:23:10.238Z\",\"locale\":\"ar\"}},{\"id\":1962,\"attributes\":{\"name\":\"enter_scratch_card_code\",\"value\":\"أدخل رمز بطاقة التعبئة\",\"createdAt\":\"2022-10-07T03:05:13.668Z\",\"updatedAt\":\"2024-10-14T02:44:51.522Z\",\"locale\":\"ar\"}},{\"id\":1964,\"attributes\":{\"name\":\"remaining_balance_upper\",\"value\":\"الرصيد المتبقي\",\"createdAt\":\"2022-10-07T03:34:16.546Z\",\"updatedAt\":\"2023-03-28T08:23:13.343Z\",\"locale\":\"ar\"}},{\"id\":1973,\"attributes\":{\"name\":\"the_description_of_ooredoo_quiz\",\"value\":\"مسابقة « Quiz Ooredoo » عبارة عن خدمة أسئلة وأجوبة تتعلق بالثقافة العامة. تمنحكم هذه المسابقة فرصة الفوز بهدية رائعة كل أسبوع وهاتف ذكي كل يوم. ماذا تنتظرون؟ اختبروا معلوماتكم، اجمعوا أكبر عدد من النقاط واربحوا!\\\"\",\"createdAt\":\"2022-10-10T02:52:08.000Z\",\"updatedAt\":\"2023-03-28T08:23:20.698Z\",\"locale\":\"ar\"}},{\"id\":1976,\"attributes\":{\"name\":\"invalid_user_name\",\"value\":\"اسم مستخدم غير صحيح\",\"createdAt\":\"2022-10-10T06:20:36.439Z\",\"updatedAt\":\"2023-03-28T08:23:21.816Z\",\"locale\":\"ar\"}},{\"id\":1978,\"attributes\":{\"name\":\"an_account_already_exists_with_this_email\",\"value\":\"المستخدم موجود بنفس البريد الإلكتروني\",\"createdAt\":\"2022-10-10T06:43:10.401Z\",\"updatedAt\":\"2023-03-28T08:23:22.878Z\",\"locale\":\"ar\"}},{\"id\":1982,\"attributes\":{\"name\":\"validity\",\"value\":\"صلاحية\",\"createdAt\":\"2022-10-10T09:46:57.863Z\",\"updatedAt\":\"2023-03-28T08:23:24.577Z\",\"locale\":\"ar\"}},{\"id\":1984,\"attributes\":{\"name\":\"about_my_ooredoo_app\",\"value\":\"حول تطبيق My Ooredoo\",\"createdAt\":\"2022-10-10T10:21:24.373Z\",\"updatedAt\":\"2023-03-28T08:23:25.917Z\",\"locale\":\"ar\"}},{\"id\":1988,\"attributes\":{\"name\":\"ooredoo_customer_space_terms_of_use\",\"value\":\"الشروط العامة لاستعمال خدمات ومحتويات تطبيق My Ooredoo.\\n\\nتم تصميم الخدمة خصيصًا لكل مستخدمي الإنترنت الذين قاموا بالاشتراك في عرض مسبق الدفع أو ما بعد الدفع لخدمة الاتصالات اللاسلكية للهاتف المحمول التي تقوم بتسويقها Ooredoo الجزائر.\\n\\nومن خلال استعمال تطبيق My Ooredoo والتسجيل فيه، يوافق المستخدم على إبرام عقد ملزم تجاه Ooredoo.\\n\\nوفي حالة ما إذا استعمل المستخدم تطبيق My Ooredoo باسم مؤسسة أو أي شخص معنوي آخر، يبقى ملزمًا تجاه Ooredoo بموجب العقد الحالي حتى لو قامت هذه المؤسسة أو الشخص المعنوي بإبرام عقد مغاير مع Ooredoo.\\n\\nيقتضي استعمال الخدمة الموافقة المسبقة ودون أية تحفظات للمستخدم على الشروط الحالية للاستعمال (المعينة أدناه بـ \\\"الشروط العامة للاستعمال\\\")\\n\\n \\n\\nالمادة 1: تعاريف\\n\\nتشير المصطلحات الآتي ذكرها بموجب الشروط العامة الحالية للاستعمال إلى:\\n\\n•             \\\"المستخدم\\\": كل شخص يستعمل الشروط العامة الحالية لاستعمال خدمات ومحتويات تطبيق My Ooredoo.\\n\\n•             \\\"المحتوى\\\": مجمل المحتويات المنتجة لفائدة المستخدم في إطار الخدمة.\\n\\n•             \\\"الخدمة\\\": مختلف الخدمات المعروضة للمستخدم في فضائه الخاص.\\n\\n•             \\\"التطبيق\\\": تطبيق الهاتف المحمول عبارة عن برنامج قابل للتحميل بشكل مجاني أو مقابل دفع سعر معين ويتم تشغيله باستعمال نظام التشغيل الخاص بالهاتف الذكي أو اللوحة الإلكترونية.\\n\\n•             \\\"طلب الشراء\\\": وثيقة تلخيصية تشير إلى خصائص المنتجات التي طلبها المشتري عبر الإنترنت والتي يجب أن يوقعها من خلال الضغط على زر الموافقة للالتزام ومباشرة عملية التسوية.\\n\\n•             \\\"العقد عن بعد\\\": أي عقد يتعلق بالسلع أو الخدمات مبرم بين الوطنية للاتصالات الجزائر ومشتري عبر الإنترنت في إطار نظام بيع أو تقديم خدمات عن بُعد تنظمه هذه الأخيرة والتي تستخدم، بموجب العقد الحالي، شبكة الإنترنت حصريًا إلى غاية إبرام العقد.\\n\\n•             \\\"الطلبية\\\": وثيقة يتعهد بموجبها المشتري عبر الإنترنت بشراء منتجات و / أو خدمات وتتعهد الوطنية لاتصالات الجزائر بتسليمها بأية وسيلة كانت.\\n\\n•             \\\"وصل الدفع\\\": وصل دفع إلكتروني يثبت عملية الدفع التي تم إجراؤها.\\n\\n•             \\\"القوة القاهرة\\\": أي حدث خارج عن إرادة الطرفين، لا يمكن التنبؤ به ولا يمكن تفاديه.\\n\\n•             \\\"المشتري عبر الإنترنت\\\": زبون البائع عبر الإنترنت وهو كل شخص طبيعي أو معنوي قام باكتتاب عقد لحامله مع بنك يصدر بطاقات الدفع ما بين البنوك CIB أو الذهبية من أجل منح بطاقة CIB أو الذهبية للدفع والسحب. وفي إطار الدفع عبر الإنترنت، يكون حامل العقد مشتريا يستخدم بطاقة CIB أو الذهبية الخاصة به للدفع مقابل خدمة أو سلعة على شبكة الإنترنت.\\n\\n•             \\\"البائع عبر الإنترنت\\\": بائع خاضع للقانون الجزائري يقوم بتسيير متجر على شبكة الإنترنت حيث يستفيد من خدمة الدفع المؤمن.\\n\\n \\n\\n \\n\\nالمادة 2: موضوع التطبيق \\n\\n يهدف تطبيق My Ooredoo إلى توفير فضاء شخصي للزبائن يسمح لهم بالاستفادة من عدة خدمات، حيث يكون الدخول إلى هذا الفضاء مجانيًا في حين ينبغي الدفع مقابل الاشتراك في الخدمات المقترحة في هذا الفضاء طبقًا لأسعار الخدمة المعمول بها، إذ يسمح هذا الأخير للزبائن بالاشتراك في الخدمات المقترحة من قبل Ooredoo وتسييرها على شبكة الإنترنت.\\n\\n \\n\\nالمادة 3: شروط الاستعمال\\n\\nتطبيق My Ooredoo مجاني (باستثناء كلفة الاتصال بالإنترنت وتكاليف الاتصال الهاتفي لطلب الحصول على معلومات إضافية تتعلق بفضاء الزبون أو الخدمة المقدمة) ويكون متوفرًا على مدار 24 ساعة في اليوم، 7 أيام في الأسبوع، باستثناء افي حالة القوة القاهرة، الأعطال الإلكترونية أو مشاكل متعلقة بشبكات الاتصالات.\\n\\n 3.1 شروط الدخول إلى الخدمة\\n\\nيُشترط استعمال تطبيق My Ooredoo حيازة هذا الأخير على جميع الأجهزة والبرامج اللازمة لتصفح الإنترنت.\\n\\nوبغية الدخول إلى هذا التطبيق واستخدامه، ينبغي أن يكون للمستخدم عنوان بريد إلكتروني صالح وشخصي، وأن يكون صاحب الخط المستعمل فيما يخص الزبائن الخواص.\\n\\n3.2 شروط فتح حساب\\n\\nيُخصص حق فتح واستعمال تطبيق My Ooredoo حصريًا لزبائن Ooredoo مهما كان عرضهم واللذين لديهم خط مسجل فيما يخص الزبائن الخواص.\\n\\n \\n\\nالمادة 4: كيفيات إنشاء وتسيير حساب My Ooredoo\\n\\n4.1 إنشاء حسابMy Ooredoo\\n\\n- تحميل التطبيق:\\n\\nبإمكان المستخدم تحميل التطبيق مباشرة على إحدى منصات التحميل على غرار Google Play، Apple App Store أو Huawei App Gallery حسب نوع الهاتف الذكي المستعمل.\\n\\n-              طلب إنشاء فضاء الزبون من قبل المستخدم:\\n\\n بإمكان الزبون تقديم طلب الدخول إلى تطبيق My Ooredoo بشكل مباشر على شبكة الإنترنت باستعمال أحد الخيارين الآتيين على التطبيق:\\n\\n-              \\\"الدخول السريع\\\"\\n\\n-              \\\"التسجيل\\\": تسجيل الدخول فيما يخص الزبائن الذين سبق لهم فتح حساب.\\n\\nوأثناء إنشاء حساب My Ooredoo، يتعين على المستخدم ملأ استمارة إنشاء الحساب التي يذكر فيها الاسم واللقب ورقم الهاتف والبريد الإلكتروني.\\n\\nيُشترط تلقي استمارة إنشاء حساب My Ooredoo المملوءة على النحو المطلوب من قبل المستخدم لإنشاء حساب.\\n\\nعند الانتهاء من عملية التسجيل، تقوم Ooredoo بإرسال رمز إلى المستخدم عن طريق رسالة قصيرة للتأكد من أنه هو من قام بمباشرة عملية إنشاء الحساب.\\n\\n \\n\\nالمادة 5: المسؤولية إزاء رموز الدخول\\n\\nيتحمل المستخدم مسؤولية الحفاظ على اسم المستخدم وكلمة السر الخاصة به ويتعين عليه اتخاذ كل الإجراءات اللازمة لتفادي اطلاع الغير على هذه الأخيرة أو الحصول عليها بأي شكل من الأشكال.\\n\\nيُقر المستخدم، بموجب موافقته على الشروط العامة الحالية لاستعمال تطبيق My Ooredoo، أنه المسؤول الوحيد والحصري تجاه Ooredoo عن أية استعمالات تتم من حسابه الخاص.\\n\\n \\n\\nالمادة 6: تسيير رموز الدخول\\n\\n6.1 في حالة فقدان أو نسيان كلمة السر المستعملة للدخول إلى تطبيق My Ooredoo\\n\\nيَحق للمستخدم في أي وقت طلب منح رموز دخول جديدة عبر الرابط \\\" كلمة السر المنسية\\\" المقترحة تحت خانة كتابة اسم المستخدم في الصفحة الرئيسية لتطبيق My Ooredoo، ويقتضي منح كلمة سر جديدة إلغاء كلمة السر السابقة.\\n\\n6.2 تغيير كلمة السر من قبل المستخدم\\n\\nيحق لأي مستخدم قام بتسجيل الدخول إلى تطبيق My Ooredoo تغيير كلمة السر الخاصة به في أي وقت في ركن \\\"تغيير كلمة السر\\\".\\n\\n6.3 التنبيهات والإعلانات الترويجية\\n\\n قد يتلقى أي مستخدم قام بتسجيل الدخول إلى تطبيق My Ooredoo تنبيهات أو إعلانات ترويجية متعلقة بنشاطه على التطبيق بخصوص الخدمات الجديدة المقترحة من قبل Ooredoo.\\n\\n \\n\\n المادة 7: غلق الحساب\\n\\n توقيف وغلق الحساب من قبل Ooredoo:\\n\\nتحتفظ Ooredoo بحق غلق أو حذف حساب المستخدم دون إشعار أو إجراء شكلي في الحالات الآتية:\\n\\n•             استعمال يتنافى مع الشروط العامة الحالية للاستعمال\\n\\n•             محاولة تسجيل دخول غير مرخص بها من خلال الاستعمال التدليسي للنظام أو سرقة رموز الدخول المبلغ عنها من قبل المستخدم أو إلغاء أو فسخ العقد الإلكتروني المبرم بين الزبون وOoredoo.  \\n\\nالمادة 8: تطور فضاء الزبون وخدماته\\n\\nقد يتم إكمال أو حذف أو تعديل أو استبدال تطبيق My Ooredoo والخدمات المقدمة والمقترحة من قبل Ooredoo في أي وقت.\\n\\nلن يتم إعلام المستخدم عن تعديل الخدمات والمحتويات بشكل تلقائي، إذ يمكن لهذا الأخير في كل مرة يسجل فيها الدخول إلى حسابه، الاطلاع بنفسه على تفاصيل الخدمات المقدمة.\\n\\nوفي حالة وجود خلل تقني أو أثناء عمليات الصيانة، قد تضطر Ooredoo إلى توقيف كل أو جزء من الخدمات ويتم إعلام المستخدم الذي يحاول تسجيل الدخول إلى حسابه بذلك.\\n\\nتتعهد Ooredoo بتنفيذ الإجراءات اللازمة لاسترجاع الخدمة في أسرع وقت ممكن، غير أنه لا يمكن تحميلها مسؤولية التوقف المؤقت للخدمة وعدم استلام المستخدم للمعلومات لأي سبب كان.\\n\\n \\n\\nالمادة 9: صحة المعلومات\\n\\nبغية ضمان السير الحسن لتطبيق My Ooredoo والخدمات والمحتويات المقدمة، يتعين على الزبون تزويد Ooredoo ببيانات شخصية دقيقة ومحدثة وصحيحة، ويتعهد بإبقائها على علم بأي تغيير من شأنه التأثير على موثوقية البيانات اللازمة للسير الحسن لتطبيق My Ooredoo.\\n\\n \\n\\nالمادة 10: الشروط العامة للبيع والدفع عبر الإنترنت\\n\\nتُسير الشروط العامة التالية للبيع جميع المعاملات عبر الإنترنت التي تم إنشاؤها على موقع eStorm.ooredoo.dz ويفترض أي طلب يتم تقديمه على هذا الموقع أن المشتري قد وافق بشكل غير مشروط ولا رجعة فيه على هذه الشروط.\\n\\nولا يحق إلا للأشخاص المؤهلين قانونًا إبرام عقود تتعلق بالسلع والخدمات المعروضة على موقع eStorm.ooredoo.dz تقديم طلب على هذا الموقع. ويعني ذلك بشكل عام أنه لكي يصبح أي فرد زبونًا ويتمكن من الطلب على موقع eStorm.ooredoo.dz، ينبغي أن يكون عمره 18 عامًا على الأقل.\\n\\n1. المنتج / الخدمة\\n\\nيتم تسويق جميع المنتجات و/ أو الخدمات الموجودة في اللائحة إلى غاية نفاذ المخزون أو توقف الخدمة المقدمة.\\n\\nتحتفظ الوطنية للاتصالات الجزائر بالحق في سحب منتج أو خدمة من اللائحة وذلك دون أي إشعار ولا تلتزم بأي حال من الأحوال بدفع تعويض أو إلغاء طلب نتيجة لعدم التمكن من استخدام المنتج الذي تم شراؤه بسبب عدم توافقه مع معدات المشتري.\\n\\n2. تقديم طلبية\\n\\nبعد اختيار الخدمة أو المنتج، تتم إضافة المنتج إلى طلب الشراء عن طريق الضغط على زر الموافقة من قبل المشتري عبر الإنترنت.\\n\\nويمكن للمشتري عبر الإنترنت تعديل طلب الشراء الخاص به في أي وقت ويمكنه العودة إلى اللائحة بالضغط على زر \\\"متابعة التسوق\\\" قبل تأكيد الطلب.\\n\\nوأثناء تأكيد طلبه، يُقدم المشتري عبر الإنترنت المعلومات المطلوبة (الاسم والعنوان ورقم الهاتف وعنوان البريد الإلكتروني وما إلى ذلك) ويتعين عليه إدخال رقم بطاقة CIB أو الذهبية الخاصة به وتاريخ نهاية الصلاحية ورمز CVV2.\\n\\nعند إتمام عملية اختيار المنتجات أو الخدمات، يتم تأكيد الطلب من خلال الضغط على زر \\\"الدفع\\\".\\n\\nويجب على المشتري عبر الإنترنت تسجيل الدخول من خلال آلية مصادقة ثلاثية الأبعاد معتمدة.\\n\\n3. السعر\\n\\nيتم الاعتماد على سعر بيع المنتج الذي يكون ساري المفعول في وقت تسجيل الطلب، باستثناء تكاليف التسليم التي قد يتحملها المشتري عبر الإنترنت والمشار إليها عند تسجيل الطلب.\\n\\nغير أنه يمكن أن تحدث أخطاء عند إدخال الأسعار وفي هذه الحالة يتم إخطار المشتري عبر الإنترنت عند إدخال طلبه. وبذلك، سيكون لديه خيار إلغاء طلبه دون أي شروط من قبل البائع عبر الإنترنت.\\n\\nقد يتم تغيير سعر بيع المنتج في أي وقت ويتم إخطار المشتري عبر الإنترنت بهذا التغيير قبل التأكيد على الطلب. وفي هذه الحالة، سيكون لديه خيار إلغاء طلبه دون أي شروط من قبل البائع عبر الإنترنت.\\n\\nالأسعار المذكورة في اللائحة محددة بالدينار الجزائري مع احتساب كل الرسوم وتعتبر سارية المفعول في وقت الاطلاع عليها من قبل المشتري عبر الإنترنت وتبقى سارية المفعول في وقت تقديم الطلب، كما يتم تقديم الطلب وإجراء المعاملات بالدينار الجزائري كذلك.\\n\\n4. تنفيذ الطلبية\\n\\nسيتم تنفيذ الطلب في مدة أقصاها يومين ابتداءً من اليوم الموالي لتأكيد الطلب من قبل المشتري عبر الإنترنت، ويمنح أي تأخير في التسليم للمشتري الحق في إلغاء طلبه.\\n\\nوفيما يخص الخدمات، ينبغي تسليمها في غضون 48 ساعة كحد أقصى ابتداء من تأكيد المشتري عبر الإنترنت لطلبه.\\n\\nأما في حالة عدم توفر المنتج أو الخدمة المطلوبة، سيتم إبلاغ المشتري عبر الإنترنت في أقرب وقت ممكن ليتمكن من إلغاء طلبه وقد يطلب هذا الأخير سداد جميع المبالغ المدفوعة في مهلة لا تتجاوز 48 ساعة بعد التأكيد على طلبه. ومع ذلك، لا يمكن معالجة أية شكوى بعد تجاوز فترة ثلاثة أشهر.\\n\\n5. التسليم\\n\\nينبغي أن يتضمن وصل الدفع عنوان تسليم / استلام البضائع. وفي هذه الحالة، يتمثل عنوان التسليم في الرقم الذي يرسله الزبون عند الطلب.\\n\\nويمكن للمشتري عبر الإنترنت، بناءً على طلبه، الحصول على فاتورة عبر البريد الإلكتروني من خلال التأكيد على الخيار المقدم لهذا الغرض في طلب الشراء.\\n\\n6. تكاليف التسليم\\n\\nقد يتحمل المشتري أو البائع عبر الإنترنت تكاليف النقل كما هو مذكور على موقع البائع الإلكتروني.\\n\\nيتم تحديد الأسعار مع احتساب كل الرسوم وتُحسب على أساس الوزن وحجم المنتجات والمسافة الجغرافية وينبغي تحديد تكلفة النقل في الفاتورة.\\n\\nفي حالة وجود خطأ أو إغفال في صياغة عنوان التسليم المذكور من قبل المشتري عبر الإنترنت يحول دون تسليمه وفي حالة غياب المستلم أثناء عملية التسليم، لا يمكن تحميل الوطنية للاتصالات الجزائر المسؤولية عن الجودة النهائية للتسليم.\\n\\n7. كيفية الدفع\\n\\nيتعين على المشتري عبر الإنترنت ضمان أن بطاقة CIB أو الذهبية الخاصة به تتوفر على أموال كافية للدفع مقابل المعاملات التي تم إجراؤها مع الوطنية لاتصالات الجزائر.\\n\\nومن أجل الحد من مخاطر الاحتيال وحماية مصالح المشتري عبر الإنترنت، يُطلب أحيانًا من البائع عبر الإنترنت التحقق من عمليات الدفع التي تتم بواسطة بطاقة CIB أو الذهبية على الموقع. وعند الانتهاء من عملية التحقق، يحتفظ البائع عبر الإنترنت بحق قبول الطلب أو رفضه وفي هذه الحالة، مباشرة عملية تسديد الأموال.\\n\\nيتم إرسال وصل الخصم مقابل المعاملة عبر البريد الإلكتروني في غضون يوم واحد من تأكيد الطلب إذا اختار المشتري عبر الإنترنت استلامه عبر البريد الإلكتروني أو يتم عرض وصل الدفع عند تأكيد الطلب من قِبل المشتري عبر الإنترنت.\\n\\nيتم تأمين الدفع عن طريق بطاقة CIB أو الذهبية من قبل مصلحة الدفع عبر الإنترنت الخاصة بمزود خدمة الدفع عبر الإنترنت الخاص بالبنك. وأثناء معاملة الدفع، يتم توصيل المشتري عبر الإنترنت تلقائيًا بخادم منصة الدفع عبر الإنترنت. ولا تمر البيانات البنكية، المحمية بالتشفير، عبر أنظمة البائع عبر الإنترنت وبالتالي لا يمكن لهذا الأخير الاحتفاظ بها.\\n\\nوللدفع عن طريق بطاقة CIB أو الذهبية، تُطبق الأحكام المتعلقة بالاستخدام التدليسي لوسائل الدفع المنصوص عليها في الاتفاقيات المبرمة بين حامل ومصدر بطاقة CIB أو الذهبية، بين الوطنية لاتصالات الجزائر والبنك الذي قام بعملية الشراء.\\n\\n8. سرية البيانات\\n\\nتُعتبر المعلومات المطلوبة من المشتري عبر الإنترنت ضرورية لمعالجة الطلب ويتم التعامل معها بسرية، ويحق للمشتري عبر الإنترنت تصحيح البيانات المتعلقة به.\\n\\nكما قد يتلقى المشتري عبر الإنترنت إعلانات ترويجية من الوطنية لاتصالات الجزائر ما لم ينص المشتري عبر الإنترنت على رفض استخدام بياناته الشخصية لأغراض تجارية وإعلانية.\\n\\nنقل رقم الهاتف: عند استخدام تطبيق MyOoredoo عبر شبكة الهاتف المحمول، يتم إرسال رقم هاتفك تلقائيًا لتسهيل عملية المصادقة وتبسيط الوصول إلى خدماتنا.\\n\\nالاستخدام المؤقت والآمن: يتم استخدام رقم هاتفك فقط خلال جلستك الحالية ولا يتم تخزينه في أنظمتنا. ويتم التعامل معها بمنتهى السرية ولا يتم مشاركتها مع أطراف ثالثة غير مصرح بها.\\n\\nالامتثال للوائح الخصوصية: نحن ملتزمون بالامتثال للقوانين واللوائح المعمول بها فيما يتعلق بحماية البيانات الشخصية.\\n\\nالتغييرات في الشروط: نحتفظ بالحق في تحديث هذه الشروط والأحكام. سيتم إرسال أي تغييرات عبر التطبيق قبل التنفيذ.\\n\\n9. إلغاء طلبية مدفوعة بواسطة بطاقة CIB أو الذهبية.\\n\\nيمكن إلغاء الطلب في أي وقت قبل تأكيده من قِبل المشتري عبر الإنترنت.\\n\\nوبغية إلغائه، يتعين على الزبون استعمال رابط الإلغاء المحدد في استمارة تأكيد الطلب عبر الإنترنت.\\n\\n10. إثبات المعاملات المدفوعة بواسطة بطاقة CIB أو الذهبية\\n\\nتُشكل بيانات المعاملات المسجلة من قبل شركة الوطنية للاتصالات الجزائر على منصة مزود خدمة الدفع عبر الإنترنت نيابة عن هذه الأخيرة دليلاً على جميع المعاملات التجارية التي تم إجراؤها بين المشتري عبر الإنترنت وشركة الوطنية للاتصالات الجزائر.\\n\\nكما يعتبر كشف الحساب البنكي كذلك دليلاً على المعاملات التي تتم بواسطة بطاقة CIB أو الذهبية عبر موقع البائع عبر الإنترنت.\\n\\n11. دخول الشروط العامة حيز التنفيذ\\n\\nتدخل الشروط العامة الحالية حيز التنفيذ عند الموافقة عليها من قِبل المشتري عبر الإنترنت وتبقى سارية المفعول حتى يوافق المشتري عبر الإنترنت على المنتج بعد انقضاء مهلة التراجع أو تقديم الخدمة.\\n\\n12. القانون المطبق\\n\\nتخضع الشروط العامة الحالية إلى القانون الجزائري.\\n\\n \\n\\nالمادة 13. الشروط الخاصة بالتعبئة عبر الإنترنت\\nينبغي أن يكون سن 18 عامًا لكي يتمكن من استخدام الخدمة،\\n  ينبغي أن يكون للمستخدم الحق في استخدام بطاقة CIB أو الذهبية التي يرسلها على موقع Ooredoo.\\nينبغي أن يقر مستخدم الخدمة أنه قد قرأ ووافق على شروط استخدام بطاقة CIB أو الذهبية المنصوص عليها من قبل البنك الذي يتعامل معه،\\n\\nيتعين على المستخدم تقديم جميع المعلومات المطلوبة قبل تأكيد طلبه،\\n\\nيتحمل الزبون وحده المسؤولية في حالة حدوث خطأ في إدخال رقم المستفيد من التعبئة،\\n\\nفي حالة حدوث خطأ في إدخال رقم المستفيد، لا يمكن تحميل Ooredoo المسؤولية حيث سيتحمل الزبون المسؤولية الكاملة إزاء ذلك،\\n\\nيتعين على مستخدم الخدمة تقديم جميع الأدلة التي تبرر شرائه (إيصال الدفع عبر الإنترنت، كشف الحساب البنكي) في حالة طلب ذلك من قبل Ooredoo عقب شكواه.\\n\\n \\n\\nالمادة 14. الشروط الخاصة بدفع فاتورة Ooredoo عبر الإنترنت\\nينبغي أن يثبت المستخدم أن عمره لا يقل عن 18 عامًا للتمكن من استخدام الخدمة،\\nينبغي أن يكون للمستخدم الحق في استخدام بطاقة CIB أو الذهبية التي يرسلها على موقع Ooredoo.\\nينبغي أن يقر مستخدم الخدمة أنه قد قرأ ووافق على شروط استخدام بطاقة CIB أو الذهبية المنصوص عليها من قبل البنك الذي يتعامل معه،\\nيتعين على المستخدم تقديم جميع المعلومات المطلوبة قبل تأكيد طلبه،\\nيتحمل الزبون وحده المسؤولية في حالة حدوث خطأ في إدخال رقم المستفيد من التعبئة،\\nفي حالة حدوث خطأ في إدخال رقم المستفيد، لا يمكن تحميل Ooredoo المسؤولية حيث سيتحمل الزبون المسؤولية الكاملة إزاء ذلك،\\nيتعين على مستخدم الخدمة تقديم جميع الأدلة التي تبرر شرائه (إيصال الدفع عبر الإنترنت، كشف الحساب البنكي) في حالة طلب ذلك من قبل Ooredoo عقب شكواه،\\nيمكن للمستخدم إلغاء طلبه في أي وقت دون أي شروط قبل تأكيد هذا الأخير ويعتبر أي تأكيد من قبل المستخدم لملخص طلبه بمثابة طلب نهائي وتفويض لا رجعة فيه لدفع السعر مع احتساب كل الرسوم عن طريق الخصم المباشر،\\nيتم تحديد جميع الأسعار والفواتير بالدينار الجزائري مع احتساب كل الرسوم،\\nيحق للمستخدم تقديم شكوى في حالة عدم تسديد فاتورته،\\nتتم معالجة شكوى العميل بحد أقصى 48 ساعة بعد صياغة الأخير،\\nبعد مرور 48 ساعة، يحق للمستخدم طلب استرداد كامل المبلغ إلى حسابه البنكي،\\n تتم عملية التسديد في غضون 7 أيام التي تلي 48 ساعة،\\n بعد مرور ثلاثة أشهر، لن تتم معالجة أي شكوى،\\nتعتبر جميع البيانات التي يرسلها المستخدم سرية للغاية وقد يتم رفع هذه السرية في حالة الاحتيال أو بناء على طلب من السلطات القانونية\\nالشروط العامة للاستعمال سارية المفعول ابتداءً من موافقة المستخدم عليها وتبقى كذلك حتى تسليم المنتج أو إعادة تسديد قيمته\\nقد تخضع الشروط العامة للاستعمال إلى تحديث\\n\\nالمادة 15: مسؤولية Ooredoo\\n\\nلا يمكن تحميل Ooredoo مسؤولية عدم الامتثال لإجراءات استعمال الخدمة لاسيما في حالة التزويد بمعلومات غير صحيحة من قبل المستخدم أثناء عملية تسجيله وينطبق ذلك كذلك على أية أضرار مباشرة أو غير مباشرة، مادية أو غير مادية تنجم مباشرة عن الاطلاع على/استخدام هذا الموقع الإلكتروني (أو أية مواقع مرتبطة به)\\n\\nكما لا تتحمل Ooredoo مسؤولية عواقب أي تدخل بدون إذن راجع لانتحال الهوية في حالة انعدام خطأ يثبت مسؤوليتها طبقا للقانون.\\n\\nالمادة 16. الملكية الفكرية\\n\\nيُعتبر تطبيق My Ooredoo ومحتواه الملكية الفكرية لـ Ooredoo وتتم حمايته بموجب حقوق الملكية الفكرية والصناعية.\\n\\n \\n\\nالمادة 17: البيانات الشخصية\\n\\nيشهد الزبون ويوافق على معالجة بياناته الشخصية من قبل Ooredoo وفي هذا الصدد يُرخص لهذه الأخيرة بمشاركة بياناته الشخصية مع الغير سواءً المتعهدين من الباطن أو أي أشخاص تختارهم Ooredoo للتدخل بشكل مباشر أو غير مباشر في الخدمات التي يتم تسويقها من قبل Ooredoo.\\n\\nوفي إطار استعمال خدمات Ooredoo، يُعتبر الزبون المسؤول الوحيد عن مجمل القوانين المطبقة فيما يخص حماية البيانات والحياة الشخصية لاسيما فيما يتعلق بدقة ونوعية وقانونية البيانات الشخصية الخاصة بالزبون التي ستتم معالجتها من قبل Ooredoo فيما يتعلق بخدماتها.\\n\\nيجب أن يحرص الزبون على أن البيانات التي يقدمها لـ Ooredoo في إطار معالجة البيانات الشخصية تتماثل للقوانين المعمول بها فيما يخص حماية البيانات الشخصية والحياة الخاصة وألا تؤدي إلى إخلال Ooredoo بالتزاماتها.\\n\\nفي حالة ما إذا استعمل الزبون الخدمات لمعالجة فئات غير مصرح بها من البيانات الشخصية في الشروط الحالية، فإنه يتحمل مسؤولية ذلك وفي هذا الصدد لن تتحمل Ooredoo مسؤولية عدم المطابقة المترتبة عن هذا الاستعمال.\\n\\n \\n\\nالمادة 18. تخزين البيانات\\n\\n1.18 تلتزم Ooredoo بالامتثال للشروط والأحكام المنصوص عليها في القانون 18-07 المتعلق بحماية الأشخاص الطبيعيين في مجال معالجة المعطيات ذات الطابع الشخصي.\\n\\n2.18 يُرخص الزبون لـ Ooredoo بتخزين بياناته الشخصية في خادم إنترنت بالجزائر أو الخارج في حالة ما إذا كان هذا التخزين ضروريًا لتقديم الخدمات التي اشترك فيها.\\n\\n3.18 يوافق المستخدم على استخدام التطبيق للبيانات البيومترية المسجلة على هاتفه الذكي حتى يتمكن من الدخول إلى التطبيق وهذا بعد إعطاء موافقته.\\n\\nلن يتم حفظ أي بيانات بيومترية في التطبيق\\n\\n \\n\\nالمادة 19.  مدة الشروط العامة للاستعمال\\n\\n تم إبرام الشروط العامة الحالية لمدة غير محددة، وبإمكان المستخدم في أي وقت التوقف عن استعمال فضاء الزبون والخدمات المقدمة على شبكة الإنترنت دون أي إشعار.\\n\\n \\n\\nالمادة 20. القانون المطبق\\n\\nيخضع فضاء الزبون إلى القانون الجزائري ويدخل ضمن اختصاص المحاكم الجزائرية.\\n\\n \\n\\nالمادة 21. الأحكام القانونية\\n\\nتُكمل الشروط الحالية للاستعمال الأحكام القانونية المتوفرة على موقع www.ooredoo.dz\\n\\n \\n\\nالمادة 22. تعديل الشروط العامة للاستعمال\\n\\nتحتفظ Ooredoo بحق تعديل الشروط العامة الحالية في أي وقت ودون أي إشعار، وعليه تدعو المستخدمين للاطلاع عليها بشكل دوري.\\n\",\"createdAt\":\"2022-10-17T04:18:52.078Z\",\"updatedAt\":\"2024-08-29T06:32:53.810Z\",\"locale\":\"ar\"}},{\"id\":1991,\"attributes\":{\"name\":\"about_my_ooredoo_app_content\",\"value\":\"حول My Ooredoo  تحكم في عرضك مع التطبيق الجديد My Ooredoo  My Ooredoo تطبيق للهاتف النقال يمكّنك من تتبع استهلاكك والاطلاع على فواتيرك واختيار اشتراكك وتعبئة رصيدك في أي وقت.  يتم إثراء محتوى My Ooredoo باستمرار بالخدمات الجديدة التي يمكنك الاطلاع عليها في ركن الخدمات.  من بين الميزات الرئيسية للتطبيق:  - الاطلاع على تفاصيل استهلاكك،  - الاطلاع على فواتيرك وتحميلها،  - دفع فواتيرك من خلال التطبيق،  - التحكم في اشتراكاتك في المكالمات والإنترنت: الاطلاع على التفاصيل والشراء،  - الاطلاع على تفاصيل عرضك،  - التحكم في أرقامك المفضلة،  - تعبئة رصيدك عن طريق بطاقة تعبئة أو عبر eStorm (باستخدام بطاقة بنكية).\",\"createdAt\":\"2022-10-17T04:27:19.694Z\",\"updatedAt\":\"2023-03-28T08:23:29.681Z\",\"locale\":\"ar\"}},{\"id\":1994,\"attributes\":{\"name\":\"about_ooredoo_content\",\"value\":\"عن شركة OOREDOO  كونها أول متعامل متعدد الوسائط للهاتف النقال في الجزائر، تعدٌ نجمة، التي أصبحت Ooredoo في 21 نوفمبر 2013، الفرع الجزائري لمجموعة Ooredoo.  العلامة نجمة متواجدة في الجزائر منذ 23 ديسمبر 2003، وهو تاريخ حصولها على رخصة التزويد بخدمات الهاتف النقال  في الجزائر. وقد تم تسويقها في 24 أوت 2004، لتوفر للجزائريين، سواء كانوا خواص أو مؤسسات، مجموعة من العروض والخدمات المستحدثة والتي تتماشى مع المعايير العالمية  قيمنا  مع الترويج للتغيير في التواصل، تم إطلاق العلامة Ooredoo في 21 نوفمبر 2013، ليخلق بذلك حقبة جديدة مع احترام خبرة نجمة وقيمها التي قامت Ooredoo بتبنيها وإثرائها :  ·  الاهتمام  من أجل مساندة، وثقة، واحترام الشخص الآخر والمسؤولية التي تجسدها Ooredoo.  ·  التواصل  من أجل التزام Ooredoo للعمل في روح تعاونية والاندماج بشكل تام في المجتمع الجزائري.  ·  التحدي  من أجل التقدم الذي تصبو إليه Ooredoo، والبحث المتواصل والتحسين وكذا التميز.  شبكة Ooredoo  تتمتع Ooredoo بشبكة تقنية فعالة، تغطي 99 % من الشعب الجزائري. وخدمة تشمل شبكة واسعة من المحلات الموزعة على كافة التراب الوطني، منها 107 فضاء Ooredoo، و3 محلات VIP، و74 محل، و9 محل في محل و345 فضاءات خدمات Ooredoo.  Ooredoo، المؤسسة المواطنة، ملتزمة تجاه المجتمع الجزائري وذلك من خلال العديد من النشاطات المواطنة، والتي تشمل الرعاية، والأعمال الخيرية، والتكفل بالعديد من الأنشطة والأحداث الرياضية، والثقافية، والاجتماعية، والاقتصادية ...إلخ.  حول مجموعة Ooredoo  Ooredoo شركة دولية رائدة في مجال الاتصالات، توفر خدمات الهاتف النقال، والثابت والأنترنت عالي التدفق وكذا خدمات المؤسسات بصفة تناسب احتياجات الخواص والمؤسسات عبر أسواق الشرق الأوسط، وشكال إفريقيا والجنوب الشرقي لآسيا. وكونها مؤسسة موجهة للشعوب، ما يقود Ooredoo هو نظرته التي تصبو إلى إثراء حياة الشعوب وقناعته بالقدرة على تحفيز التطور الإنساني عبر التواصل من أجل مساعدة الشعوب لبلوغ أهدافها وذلك بفضل إمكاناتها. Ooredoo حاضر في الأسواق مثل قطر، والكويت، وسلطنة عمان، والجزائر، وتونس، والعراق، وفلسطين، وجزر المالديف وأندونيسيا. حققت الشركة في سنة 2012 مداخيل بلغت 9,3 مليار دولار مع قاعدة عملاء تتجاوز 92,9 مليون زبون إلى غاية 31 ديسمبر 2012. الشركة الأم لـ Ooredoo هي Ooredoo Q.S.C. (اتصالات قطر Qtel Q.S.C. سابقا)، والتي تتداول أسهمها في بورصة قطر « Qatar Exchange » وفي بورصة أبو ظبي « Abu Dhabi Securities Exchange ».  سعادة الشيخ عبد الله بن محمد بن سعود آل ثاني هو رئيس مجلس إدارة اتصالات قطر (Qtel). وكونه رئيسا، يتمتع الشيخ عبد الله بمجموعة واسعة من المهارات التجارية، والتجربة والمعارف. فقد قام بتحسين نظام تسيير الشركة Qtel ليتم توجيهها وضبطها بطريقة فعالة وفقا للممارسات الدولية، معززا بذلك مسؤولية المؤسسات من جهة وخلقا مستداما لثروة أصحاب الأسهم. ويوافق الرئيس ومجلس الإدارة على جميع اقتراحات الصفقات الجديدة والهامة، بما في ذلك امتلاك الشركات التابعة، والمشاريع الكبرى لرؤوس الأموال، وامتلاك أو التنازل عن الأصول الهامة.  أشرف الشيخ عبد الله على إعادة هيكلة والتوسع الإقليمي لـ Qtel.  بعد اكتساب Qtel كويت – وطنية، التي كانت تعتبر آنذاك أهم عقد اتصالات في العالم العربي، أصبح الشيخ عبد الله رئيسا لـوطنية.  شغل الشيخ عبد الله عدة مناصب هامة في قطر، من بينها أمير الديوان، من سنة 2000 إلى غاية 2005. ويجدر الذكر أن سعادته يشغل منصب وزير، وكذا عضو مجلس التخطيط القطري. يملك الشيخ عبد الله خبرة واسعة في المجال العسكري والطيران. فقد تحصل على شهادة طيار من القوات الجوية للجيش البريطاني واستكمل دراسته في « Collège Senior Militaire Guerre » للقوات المسلحة الأمريكية. فهو مدرب طيار لدى القوات الجوية الملكية البريطانية. وفي سنة 1993، تم تعيينه مدربا رئيسيا في القوات الجوية لقطر، وقائدا للسرب 6SQN في 1996 وملحق عسكري في سفارة دولة قطر في المملكة المتحدة في 1999\",\"createdAt\":\"2022-10-17T08:13:05.140Z\",\"updatedAt\":\"2023-03-28T08:23:30.885Z\",\"locale\":\"ar\"}},{\"id\":1996,\"attributes\":{\"name\":\"exclusive_settings_enable_rate_plans_array\",\"value\":\"{   \\\"EXCLUSIVE_SETTINGS_ENABLE_RATE_PLANS\\\": [          \\\"DIMA\\\",\\\"LA GOLD JDIDA\\\", \\\"LA GOLD\\\" ] }\",\"createdAt\":\"2022-10-17T10:23:12.159Z\",\"updatedAt\":\"2024-08-27T10:04:29.574Z\",\"locale\":\"ar\"}},{\"id\":1998,\"attributes\":{\"name\":\"rate_plans_array\",\"value\":\"{   \\\"RATE_PLANS\\\": [          \\\"DIMA\\\",\\\"LA GOLD\\\",\\\"LA GOLD JDIDA\\\"     ] }\",\"createdAt\":\"2022-10-17T10:24:08.446Z\",\"updatedAt\":\"2023-03-29T18:05:30.351Z\",\"locale\":\"ar\"}},{\"id\":2000,\"attributes\":{\"name\":\"promotion_enable_rate_plans_array\",\"value\":\"{\\n    \\\"PROMOTION_ENABLE_RATE_PLANS\\\": [\\n        {\\n            \\\"plan\\\": \\\"LA GOLD\\\",\\n            \\\"period\\\": 0\\n        },\\n        {\\n            \\\"plan\\\": \\\"LA GOLD JDIDA\\\",\\n            \\\"period\\\": 3\\n        },\\n        {\\n            \\\"plan\\\": \\\"DIMA\\\",\\n            \\\"period\\\": 0\\n        },\\n        {\\n            \\\"plan\\\": \\\"SIM N'ternet\\\",\\n            \\\"period\\\": 6\\n        }\\n    ]\\n}\",\"createdAt\":\"2022-10-17T11:10:34.922Z\",\"updatedAt\":\"2024-12-18T12:09:41.784Z\",\"locale\":\"ar\"}},{\"id\":2004,\"attributes\":{\"name\":\"this_will_delete_your_my_ooredoo_account_and_all_associated_personal_data_however_you_will_be_able_continue_using_your_ooredoo_services_continue\",\"value\":\"سيؤدي هذا إلى حذف حساب My Ooredoo الخاص بك وجميع البيانات الشخصية المرتبطة به. ومع ذلك ستتمكن من الاستمرار في استخدام خدمات Ooredoo الخاصة بك. يكمل؟\",\"createdAt\":\"2022-10-19T04:46:48.374Z\",\"updatedAt\":\"2023-03-28T08:23:33.377Z\",\"locale\":\"ar\"}},{\"id\":2006,\"attributes\":{\"name\":\"delete_my_account\",\"value\":\"احذف حسابي\",\"createdAt\":\"2022-10-19T04:51:53.838Z\",\"updatedAt\":\"2023-03-28T08:23:32.013Z\",\"locale\":\"ar\"}},{\"id\":2008,\"attributes\":{\"name\":\"delete_my_account_upper\",\"value\":\"احذف حسابي\",\"createdAt\":\"2022-10-19T04:52:31.454Z\",\"updatedAt\":\"2023-03-28T08:23:34.470Z\",\"locale\":\"ar\"}},{\"id\":2011,\"attributes\":{\"name\":\"verify_upper\",\"value\":\"تحقق\",\"createdAt\":\"2022-10-19T06:20:04.846Z\",\"updatedAt\":\"2023-03-28T08:22:18.000Z\",\"locale\":\"ar\"}},{\"id\":2019,\"attributes\":{\"name\":\"core_services\",\"value\":\"الخدمات الأساسية\",\"createdAt\":\"2022-10-22T05:33:13.373Z\",\"updatedAt\":\"2023-03-28T08:23:42.066Z\",\"locale\":\"ar\"}},{\"id\":2020,\"attributes\":{\"name\":\"for_dima_and_la_gold_jdida_users\",\"value\":\"لمستخدمي عرضي Dima وLa Gold Jdida\",\"createdAt\":\"2022-10-22T11:37:26.526Z\",\"updatedAt\":\"2024-09-04T08:20:11.059Z\",\"locale\":\"ar\"}},{\"id\":2022,\"attributes\":{\"name\":\"your_bundle_will_automatically_renew_again_on_renewal_date\",\"value\":\"سيتم تجديد اشتراكك تلقائيًا يوم {renewal_date}\",\"createdAt\":\"2022-10-22T11:41:59.