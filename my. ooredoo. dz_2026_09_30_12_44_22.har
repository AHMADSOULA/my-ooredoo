":2297,\"attributes\":{\"name\":\" 400 DA: 5GB of internet Valid for 7 days_Card_Confirmation_Message\",\"value\":\"مع بطاقة CIB أو الذهبية، ضاعفوا اشتراك الإنترنت! 6Go إنترنت + يوتيوب غير محدود، الكل صالح 72 ساعة بـ 300 دج فقط!\",\"createdAt\":\"2022-11-10T14:18:29.185Z\",\"updatedAt\":\"2026-04-06T08:49:20.616Z\",\"locale\":\"ar\"}},{\"id\":2299,\"attributes\":{\"name\":\"or_continue_with\",\"value\":\"أو المواصلة مع\",\"createdAt\":\"2022-11-10T14:19:55.866Z\",\"updatedAt\":\"2023-03-28T08:10:57.465Z\",\"locale\":\"ar\"}},{\"id\":2301,\"attributes\":{\"name\":\"confirm_password\",\"value\":\"تأكيد كلمة السر\",\"createdAt\":\"2022-11-10T14:20:19.905Z\",\"updatedAt\":\"2023-03-28T08:11:23.462Z\",\"locale\":\"ar\"}},{\"id\":2302,\"attributes\":{\"name\":\"enter_current_password\",\"value\":\"قم بإدخال كلمة السر الحالية\",\"createdAt\":\"2022-11-10T14:24:08.166Z\",\"updatedAt\":\"2023-03-28T08:14:58.304Z\",\"locale\":\"ar\"}},{\"id\":2304,\"attributes\":{\"name\":\"convert_to_data\",\"value\":\"التحويل إلى حجم إنترنت\",\"createdAt\":\"2022-11-10T14:25:27.928Z\",\"updatedAt\":\"2023-03-28T08:16:20.242Z\",\"locale\":\"ar\"}},{\"id\":2306,\"attributes\":{\"name\":\"convert_to_minutes\",\"value\":\"التحويل إلى دقائق\",\"createdAt\":\"2022-11-10T14:25:32.355Z\",\"updatedAt\":\"2023-03-28T08:16:23.820Z\",\"locale\":\"ar\"}},{\"id\":2308,\"attributes\":{\"name\":\"enter_the_code_below_to_verify\",\"value\":\"قم بإدخال الرمز أدناه للتأكد\",\"createdAt\":\"2022-11-10T14:26:10.561Z\",\"updatedAt\":\"2023-03-28T08:17:02.731Z\",\"locale\":\"ar\"}},{\"id\":2309,\"attributes\":{\"name\":\"nice_you_purchased_bundle_name\",\"value\":\"هنيئًا! لقد قمت بشراء \\\"اسم الاشتراك\\\"\",\"createdAt\":\"2022-11-10T14:26:41.232Z\",\"updatedAt\":\"2023-03-28T08:17:29.657Z\",\"locale\":\"ar\"}},{\"id\":2310,\"attributes\":{\"name\":\"user_name_personal_phone\",\"value\":\"{user_name}\",\"createdAt\":\"2022-11-10T14:27:19.259Z\",\"updatedAt\":\"2023-03-28T08:18:04.131Z\",\"locale\":\"ar\"}},{\"i